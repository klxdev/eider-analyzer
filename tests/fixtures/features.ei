// features: the fixture of rename, signature help, inlay hints, workspace symbols, code lenses
// and "add the missing match arm" (session features)

pub type Shape = | Circle(r: i32) | Square(side: i32) | Tri(a: i32, b: i32)

type Point = { x: i32, y: i32 }

fn scale(p: Point, by: i32 = 2, label: str = "p") -> Point {
    Point(p.x * by, p.y * by)
}

impl Point {
    fn shifted(self, dx: i32, dy: i32) -> Point {
        Point(self.x + dx, self.y + dy)
    }
}

fn area(s: Shape) -> i32 {
    match s {
        Circle(r) => 3 * r * r
        Square(side) => side * side
    }
}

fn main() uses io {
    let p = Point(1, 2)
    let q = scale(p, 3)
    let total = q.shifted(1, 2).x + area(Circle(2))
    let x = 5
    let n = scale(Point(x, 1)).y
    print(total + n)
}

test "scale doubles" {
    assert scale(Point(1, 1)).x == 2
}

fn pick(o: Option[i32]) -> i32 { o.unwrap_or(0) }

fn labelled() -> Point {
    scale(Point(3, 4), label = "z")
}
