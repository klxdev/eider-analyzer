// geo: a module the main fixture imports.

pub type Point = { x: i32, y: i32 }

pub type Shape = | Circle(r: i32) | Rect(w: i32, h: i32)

pub const ORIGIN_X: i32 = 0

pub fn area(s: Shape) -> i32 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
    }
}

fn helper() -> i32 { 1 }
