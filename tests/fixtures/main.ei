import "geo.ei" as g

type Pair = { left: i32, right: i32 }

impl Pair {
    fn sum(self) -> i32 { self.left + self.right }
}

const LIMIT: i32 = 10

fn total(items: List[Pair]) -> i32 {
    var acc = 0
    for p in items {
        acc = acc + p.sum()
    }
    acc
}

fn main() uses io {
    let p = Pair(1, 2)
    var items: List[Pair] = List.new()
    items.push(p)
    let shape = g.Circle(2)
    print(total(items) + g.area(shape) + LIMIT + p.left)
}

test "sums" {
    let q = Pair(3, 4)
    assert q.sum() == 7
}
