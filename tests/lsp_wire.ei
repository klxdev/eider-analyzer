// lsp-wire: the test client's framing tool (tests/run.sh).
//
//   lsp-wire frame <root>     stdin: a session script; stdout: the framed byte stream
//   lsp-wire deframe <root>   stdin: the server's stdout; stdout: one message body per line
//
// Session scripts have one JSON-RPC message per line; `${ROOT}` is replaced by <root>
// (deframe writes it back, so goldens don't depend on where the repository is). Empty lines
// and lines starting with `#` are skipped. Directives:
//
//   !open <uri-path> <version>   didOpen with the text of the file at <root>/<uri-path>
//   !change <uri-path> <version> <file>   didChange (full text) with the text of <root>/<file>
//   !raw <text>                  <text> as is, with \r and \n meaning CR and LF (malformed input)
//   !body <text>                 <text> framed as is, without ${ROOT} or JSON checks

import core.sys
import std.bytes
import std.io
import std.fs
import std.env
import json
import eider_analyzer.lsp_rpc as rpc

fn subst(s: List[u8], from: List[u8], to: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        if from.len() > 0 && bytes.starts_with(bytes.slice(s, i, i + from.len()), from) {
            bytes.append(inout out, to)
            i += from.len()
        } else {
            out.push(s[i])
            i += 1
        }
    }
    out
}

fn words(l: List[u8]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for w in bytes.split(l, 32) {
        if w.len() > 0 { out.push(w) }
    }
    out
}

fn read_or_die(path: List[u8]) -> List[u8] uses io, fs {
    match fs.read(path) {
        Ok(t) => t
        Err(_) => {
            let mut m = sys.lit("lsp-wire: cannot read ")
            bytes.append(inout m, path)
            io.errln(m)
            env.exit(2)
            List.new()
        }
    }
}

fn uri(root: List[u8], p: List[u8]) -> List[u8] {
    let mut u = sys.lit("file://")
    bytes.append(inout u, root)
    u.push(47)
    bytes.append(inout u, p)
    u
}

fn hexval(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    -1
}

/// `\r`, `\n` and `\xHH` as bytes.
fn unescape(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        if s[i] == 92 && i + 1 < s.len() && s[i + 1] == 114 {
            out.push(13)
            i += 2
        } else if s[i] == 92 && i + 1 < s.len() && s[i + 1] == 110 {
            out.push(10)
            i += 2
        } else if s[i] == 92 && i + 3 < s.len() && s[i + 1] == 120 && hexval(s[i + 2]) >= 0 && hexval(s[i + 3]) >= 0 {
            out.push((hexval(s[i + 2]) * 16 + hexval(s[i + 3])) as u8)
            i += 4
        } else {
            out.push(s[i])
            i += 1
        }
    }
    out
}

fn frame(root: List[u8]) uses io, fs {
    let input: List[u8] = match io.read_all() {
        Ok(t) => t
        Err(_) => List.new()
    }
    let var_root = sys.lit("${ROOT}")
    let mut out: List[u8] = List.new()
    for line in bytes.split(input, 10) {
        let mut l = line.copy()
        if l.len() > 0 && l[l.len() - 1] == 13 { l = bytes.slice(l, 0, l.len() - 1) }
        if l.len() == 0 || l[0] == 35 { continue }
        if bytes.starts_with(l, sys.lit("!raw ")) {
            bytes.append(inout out, unescape(bytes.slice(l, 5, l.len())))
            continue
        }
        if bytes.starts_with(l, sys.lit("!body ")) {
            bytes.append(inout out, rpc.frame(bytes.slice(l, 6, l.len())))
            continue
        }
        if bytes.starts_with(l, sys.lit("!open ")) || bytes.starts_with(l, sys.lit("!change ")) {
            let w = words(l)
            let open = bytes.eq(w[0], sys.lit("!open"))
            let file = if open { w[1] } else { w[3] }
            let mut src_path = root.copy()
            src_path.push(47)
            bytes.append(inout src_path, file)
            let text = read_or_die(src_path)
            let mut b: List[u8] = List.new()
            if open {
                b = sys.lit("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":")
                json.quote_into(inout b, uri(root, w[1]))
                bytes.append(inout b, sys.lit(",\"languageId\":\"eider\",\"version\":"))
                bytes.append(inout b, w[2])
                bytes.append(inout b, sys.lit(",\"text\":"))
                json.quote_into(inout b, text)
                bytes.append(inout b, sys.lit("}}}"))
            } else {
                b = sys.lit("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":")
                json.quote_into(inout b, uri(root, w[1]))
                bytes.append(inout b, sys.lit(",\"version\":"))
                bytes.append(inout b, w[2])
                bytes.append(inout b, sys.lit("},\"contentChanges\":[{\"text\":"))
                json.quote_into(inout b, text)
                bytes.append(inout b, sys.lit("}]}}"))
            }
            bytes.append(inout out, rpc.frame(b))
            continue
        }
        bytes.append(inout out, rpc.frame(subst(l, var_root, root)))
    }
    io.out(out)
}

fn deframe(root: List[u8]) uses io {
    let input: List[u8] = match io.read_all() {
        Ok(t) => t
        Err(_) => List.new()
    }
    let mut f = rpc.framer()
    rpc.feed(inout f, input)
    let mut out: List[u8] = List.new()
    let mut going = true
    while going {
        match rpc.next(inout f) {
            rpc.Body(b) => {
                bytes.append(inout out, subst(b, root, sys.lit("${ROOT}")))
                out.push(10)
            }
            rpc.Dropped(why) => {
                bytes.append(inout out, sys.lit("!dropped "))
                bytes.append(inout out, why)
                out.push(10)
            }
            rpc.NeedMore => { going = false }
        }
    }
    if f.pos < f.buf.len() {
        bytes.append(inout out, sys.lit("!trailing bytes"))
        out.push(10)
    }
    io.out(out)
}

fn main() uses io, fs {
    let argv = env.args()
    if argv.len() < 3 {
        io.errln(sys.lit("usage: lsp-wire frame|deframe <root>"))
        env.exit(2)
    }
    if bytes.eq(argv[1], sys.lit("frame")) { frame(argv[2]) } else { deframe(argv[2]) }
}
