# UTF-16 positions with non-ASCII text before code on the same line (tests/fixtures/unicode.ei):
# 😀 is one Eider column but two UTF-16 units; é, 漢 and the quotes are one of each
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":"file://${ROOT}/fixtures","capabilities":{}}}
{"jsonrpc":"2.0","method":"initialized","params":{}}
!open fixtures/unicode.ei 1
# `count` on line 3 (after é😀😀) -> its declaration on line 2 (after 😀漢)
{"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{"textDocument":{"uri":"file://${ROOT}/fixtures/unicode.ei"},"position":{"line":3,"character":34}}}
{"jsonrpc":"2.0","id":3,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://${ROOT}/fixtures/unicode.ei"},"position":{"line":3,"character":26}}}
