// lsp_features: LSP results computed from one analysis (lsp_model.Analysis) and the texts
// it was computed from. Every function returns the JSON text of a `result`; none of them
// can fail: a position nothing is at gives `null` or an empty list.

import core.sys
import std.bytes
import json
import eider_analyzer.lsp_model as m
import eider_analyzer.lsp_text as t
import eider_analyzer.lsp_rpc as rpc
import eider_analyzer.lsp_analysis as analysis

/// An analysis of the document `uri` (file 0): the texts of every file in `an.files` as
/// they were analysed (empty when unreadable) and their line tables.
pub type Res = { an: m.Analysis, texts: List[List[u8]], starts: List[List[u32]], uri: List[u8], version: i64 }

pub fn uri_of(r: Res, file: u32) -> List[u8] {
    if file == 0 { return r.uri }
    if (file as usize) < r.an.files.len() { return t.path_to_uri(r.an.files[file as usize]) }
    r.uri
}

fn pos_json(inout o: List[u8], p: t.Pos) {
    bytes.append(inout o, sys.lit("{{\"line\":"))
    bytes.append(inout o, rpc.num(p.line as u64))
    bytes.append(inout o, sys.lit(",\"character\":"))
    bytes.append(inout o, rpc.num(p.ch as u64))
    o.push(125)
}

/// Eider (line, col) in file `file` as an LSP position.
pub fn lsp_pos(r: Res, file: u32, line: u32, col: u32) -> t.Pos {
    let f = file as usize
    if f < r.texts.len() && r.texts[f].len() > 0 { return t.to_lsp(r.texts[f], r.starts[f], line, col) }
    // no text: assume ASCII
    let l: u32 = if line > 0 { line - 1 } else { 0 }
    let c: u32 = if col > 0 { col - 1 } else { 0 }
    t.Pos(l, c)
}

pub fn range_json(inout o: List[u8], r: Res, s: m.Span) {
    bytes.append(inout o, sys.lit("{{\"start\":"))
    pos_json(inout o, lsp_pos(r, s.file, s.line, s.col))
    bytes.append(inout o, sys.lit(",\"end\":"))
    pos_json(inout o, lsp_pos(r, s.file, s.end_line, s.end_col))
    o.push(125)
}

fn location_json(inout o: List[u8], r: Res, s: m.Span) {
    bytes.append(inout o, sys.lit("{{\"uri\":"))
    json.quote_into(inout o, uri_of(r, s.file))
    bytes.append(inout o, sys.lit(",\"range\":"))
    range_json(inout o, r, s)
    o.push(125)
}

/// An LSP position in the document as Eider (line, col) packed (lsp_text.pack).
pub fn eider_pos(r: Res, p: t.Pos) -> u64 {
    if r.texts.len() == 0 { return t.pack(p.line + 1, p.ch + 1) }
    t.from_lsp(r.texts[0], r.starts[0], p)
}

fn inside(s: m.Span, l: u32, c: u32) -> bool {
    s.file == 0 && t.contains(s.line, s.col, s.end_line, s.end_col, l, c)
}

/// What is at the position: a reference's target or a declaration, with the span there.
type Hit = { sym: u32, span: m.Span, found: bool }

fn hit_at(r: Res, p: t.Pos) -> Hit {
    let e = eider_pos(r, p)
    let l = t.pk_line(e)
    let c = t.pk_col(e)
    for x in r.an.refs {
        if inside(x.span, l, c) && (x.target as usize) < r.an.symbols.len() { return Hit(x.target, x.span, true) }
    }
    for i in 0..r.an.symbols.len() {
        let sp = r.an.symbols[i].span
        if inside(sp, l, c) && !whole_module(r.an.symbols[i]) { return Hit(i as u32, sp, true) }
    }
    // the end of an identifier (the cursor just after it) counts too
    if c > 1 {
        for x in r.an.refs {
            if x.span.file == 0 && x.span.end_line == l && x.span.end_col == c && (x.target as usize) < r.an.symbols.len() { return Hit(x.target, x.span, true) }
        }
    }
    Hit(0, m.Span(0, 0, 0, 0, 0), false)
}

// ---- definition, references

pub fn definition(r: Res, p: t.Pos) -> List[u8] {
    let h = hit_at(r, p)
    if !h.found { return sys.lit("null") }
    let s = r.an.symbols[h.sym as usize]
    let mut o: List[u8] = List.new()
    if s.kind == m.SK_MODULE && s.span.file == 0 && !whole_module(s) {
        // the lexical stand-in's import symbol: the module's file, as ide.ei's module symbol is
        let mf = module_file(r, s)
        if mf != 0 {
            location_json(inout o, r, m.Span(mf, 1, 1, 1, 1))
            return o
        }
    }
    location_json(inout o, r, s.span)
    o
}

/// `eider/expand`: the specializations of reflective bodies for the symbol at the position,
/// as `[{"name":..., "text":...}]`: the ones specialized from the declaration it is (or its
/// calls resolve to), or, for a type, the ones for that type (`Point.enc`). The text is what
/// `eiderc expand` prints (compiler/ide.ei's `Expansion`).
pub fn expansions(r: Res, p: t.Pos) -> List[u8] {
    let mut o = sys.lit("[")
    let h = hit_at(r, p)
    if h.found {
        let s = r.an.symbols[h.sym as usize]
        let mut pre = s.name.copy()
        pre.push(46)
        for x in r.an.expansions {
            let from = x.file == s.span.file && x.line == s.span.line && x.col == s.span.col
            if !from && !bytes.starts_with(x.name, pre) { continue }
            rpc.sep(inout o)
            o.push(123)
            rpc.kv_str(inout o, "name", x.name)
            rpc.kv_str(inout o, "text", x.text)
            o.push(125)
        }
    }
    o.push(93)
    o
}

pub fn references(r: Res, p: t.Pos, include_decl: bool) -> List[u8] {
    let h = hit_at(r, p)
    if !h.found { return sys.lit("null") }
    let mut o = sys.lit("[")
    if include_decl {
        location_json(inout o, r, r.an.symbols[h.sym as usize].span)
    }
    for x in r.an.refs {
        if x.target == h.sym {
            rpc.sep(inout o)
            location_json(inout o, r, x.span)
        }
    }
    o.push(93)
    o
}

// ---- hover

pub fn hover(r: Res, p: t.Pos) -> List[u8] uses fs {
    let e = eider_pos(r, p)
    let l = t.pk_line(e)
    let c = t.pk_col(e)
    let h0 = hit_at(r, p)
    // the innermost type at the position
    let mut ty: List[u8] = List.new()
    let mut ty_span = m.Span(0, 0, 0, 0, 0)
    let mut best: u64 = 18446744073709551615
    for x in r.an.types {
        if inside(x.span, l, c) {
            let size = t.pack(x.span.end_line - x.span.line, x.span.end_col) - t.pack(0, x.span.col)
            if size < best {
                best = size
                ty = x.text
                ty_span = x.span
            }
        }
    }
    let mut h = h0.copy()
    let mut builtin: List[u8] = List.new()
    if !h.found && r.texts.len() > 0 && r.texts[0].len() > 0 {
        // a name the checker recorded no reference for: a prelude item (`From` in
        // `impl From[E] for T`) or a built-in type (`Ref` in `Ref.new(x)`)
        let off = t.offset_of(r.texts[0], r.starts[0], l, c)
        let w = t.word_at(r.texts[0], off)
        let a = (w / 4294967296) as usize
        let b = (w % 4294967296) as usize
        if b > a {
            let name = bytes.slice(r.texts[0], a, b)
            let col = c - ((off - a) as u32)
            let wspan = m.Span(0, l, col, l, col + ((b - a) as u32))
            let pre = prelude_file(r)
            for i in 0..r.an.symbols.len() {
                let x = r.an.symbols[i]
                if pre != 0 && x.span.file == pre && (x.kind == m.SK_TYPE || x.kind == m.SK_VARIANT || x.kind == m.SK_TRAIT) && bytes.eq(x.name, name) {
                    h = Hit(i as u32, wspan, true)
                    break
                }
            }
            if !h.found && ty.len() == 0 {
                builtin = builtin_doc(name)
                if builtin.len() == 0 { builtin = namespace_doc(r, name) }
                if builtin.len() > 0 { ty_span = wspan }
            }
        }
    }
    if !h.found && ty.len() == 0 && builtin.len() == 0 { return sys.lit("null") }
    let mut md: List[u8] = List.new()
    let mut span = ty_span.copy()
    if builtin.len() > 0 {
        md = builtin
    } else if h.found {
        let s = r.an.symbols[h.sym as usize]
        span = h.span
        md = sys.lit("```eider\n")
        let mut d = s.detail.copy()
        if d.len() == 0 { d = s.name }
        // a module (ide.ei's detail is its file's path): its dotted name, `module std.bytes`
        if whole_module(s) && (s.span.file as usize) < r.an.files.len() {
            d = sys.lit("module ")
            bytes.append(inout d, analysis.module_label(r.an.files[s.span.file as usize]))
        }
        // ide.ei's detail of a local is its type
        if s.kind == m.SK_LOCAL && !bytes.starts_with(d, s.name) && !bytes.starts_with(d, sys.lit("let")) && !bytes.starts_with(d, sys.lit("var")) && !bytes.starts_with(d, sys.lit("for")) {
            let mut x = s.name.copy()
            bytes.append(inout x, sys.lit(": "))
            bytes.append(inout x, d)
            d = x
        }
        bytes.append(inout md, d)
        bytes.append(inout md, sys.lit("\n```"))
        let mut what = sys.lit(m.kind_name(s.kind))
        if s.container != m.NONE && (s.container as usize) < r.an.symbols.len() {
            bytes.append(inout what, sys.lit(" in `"))
            bytes.append(inout what, r.an.symbols[s.container as usize].name)
            what.push(96)
        }
        if s.span.file != 0 && (s.span.file as usize) < r.an.files.len() {
            bytes.append(inout what, sys.lit(" (`"))
            bytes.append(inout what, base_name(r.an.files[s.span.file as usize]))
            bytes.append(inout what, sys.lit("`)"))
        }
        bytes.append(inout md, sys.lit("\n\n"))
        bytes.append(inout md, what)
        let shown = bytes.find(d, ty, 0).is_some()
        if ty.len() > 0 && !shown {
            bytes.append(inout md, sys.lit("\n\ntype: `"))
            bytes.append(inout md, ty)
            md.push(96)
        }
    } else {
        md = sys.lit("```eider\n")
        bytes.append(inout md, ty)
        bytes.append(inout md, sys.lit("\n```"))
    }
    let mut o = sys.lit("{{\"contents\":{{\"kind\":\"markdown\",\"value\":")
    json.quote_into(inout o, md)
    bytes.append(inout o, sys.lit("}},\"range\":"))
    range_json(inout o, r, span)
    o.push(125)
    o
}

/// Hover text for a built-in type or function (they have no declaration to show).
fn builtin_doc(name: List[u8]) -> List[u8] {
    let mut sig = ""
    let mut what = ""
    if bytes.eq(name, sys.lit("Ref")) {
        sig = "type Ref[T]"
        what = "built-in type: a shared mutable cell, `Ref.new(v)`; `get`, `set`, `read(|x| ...)`, `update(|inout x| ...)` (docs/compiler.md, \"C8.7\")"
    } else if bytes.eq(name, sys.lit("List")) {
        sig = "type List[T]"
        what = "built-in type: a growable array (copy-on-write)"
    } else if bytes.eq(name, sys.lit("Map")) {
        sig = "type Map[K, V]"
        what = "built-in type: a hash map (`K: Hash + Eq`); `for (k, v) in m`"
    } else if bytes.eq(name, sys.lit("String")) {
        sig = "type String"
        what = "built-in type: UTF-8 text without NUL"
    } else if bytes.eq(name, sys.lit("str")) {
        sig = "type str"
        what = "built-in type: a string literal's text"
    } else if bytes.eq(name, sys.lit("Box")) {
        sig = "type Box[T]"
        what = "built-in type: a value on the heap; `get`, `set`"
    } else if bytes.eq(name, sys.lit("Mutex")) {
        sig = "type Mutex[T]"
        what = "built-in type: a value shared between threads; `get`, `set`, `update`"
    } else if bytes.eq(name, sys.lit("Chan")) {
        sig = "type Chan[T]"
        what = "built-in type: a queue between threads; `send`, `recv`, `close`"
    } else if bytes.eq(name, sys.lit("Task")) {
        sig = "type Task[T]"
        what = "built-in type: a spawned thread; `join`"
    } else {
        return List.new()
    }
    let mut md = sys.lit("```eider\n")
    bytes.append(inout md, sys.lit(sig))
    bytes.append(inout md, sys.lit("\n```\n\n"))
    bytes.append(inout md, sys.lit(what))
    md
}

/// Hover text for a package namespace's alias (`std` of `import std`, which names no module
/// and so has no reference; docs/compiler.md, "C8.26"), or empty.
fn namespace_doc(r: Res, name: List[u8]) -> List[u8] {
    if r.texts.len() == 0 { return List.new() }
    for im in analysis.imports_in(r.texts[0]) {
        if im.form != m.IM_NAMESPACE || !bytes.eq(im.alias, name) { continue }
        let mut md = sys.lit("```eider\nimport ")
        bytes.append(inout md, im.path)
        if !bytes.eq(im.path, name) {
            bytes.append(inout md, sys.lit(" as "))
            bytes.append(inout md, name)
        }
        bytes.append(inout md, sys.lit("\n```\n\npackage namespace: `"))
        bytes.append(inout md, name)
        bytes.append(inout md, sys.lit(".<module>.<item>` names an item of one of its modules, which is loaded by its first use"))
        return md
    }
    List.new()
}

fn base_name(path: List[u8]) -> List[u8] {
    match bytes.rfind_byte(path, 47) {
        Some(i) => bytes.slice(path, i + 1, path.len())
        None => path
    }
}

// ---- document symbols

/// LSP SymbolKind for a symbol (`variants`: a type with variants is an Enum).
fn symbol_kind(k: u32, variants: bool) -> u64 {
    if k == m.SK_MODULE { return 2 }
    if k == m.SK_TYPE {
        if variants { return 10 }
        return 23
    }
    if k == m.SK_VARIANT { return 22 }
    if k == m.SK_FIELD { return 8 }
    if k == m.SK_FN { return 12 }
    if k == m.SK_METHOD { return 6 }
    if k == m.SK_CONST { return 14 }
    if k == m.SK_TRAIT { return 11 }
    if k == m.SK_TEST { return 24 }
    // LSP has no label kind: Key, a name that stands for a place in the code
    if k == m.SK_LABEL { return 20 }
    13
}

fn outline(k: u32) -> bool { k != m.SK_PARAM && k != m.SK_LOCAL }

/// ide.analyze's symbol for a whole module (span 1:1-1:1, full: the file): not an item of
/// the outline. (The lexical fallback's module symbols are import aliases, with a name span.)
fn whole_module(s: m.Symbol) -> bool {
    s.kind == m.SK_MODULE && s.span.line == s.span.end_line && s.span.col == s.span.end_col
}

/// The source text of a span in file 0 (empty if it spans lines).
fn span_text(r: Res, s: m.Span) -> List[u8] {
    if s.file != 0 || s.line != s.end_line || r.texts.len() == 0 { return List.new() }
    let a = t.offset_of(r.texts[0], r.starts[0], s.line, s.col)
    let b = t.offset_of(r.texts[0], r.starts[0], s.end_line, s.end_col)
    bytes.slice(r.texts[0], a, b)
}

/// The import aliases of the document (`g` in `import "geo.ei" as g` or `import app.geo as g`,
/// `geo` without `as`)
/// with the file of their module: (name, file) from references to module symbols.
type Alias = { name: List[u8], file: u32 }

fn aliases(r: Res) -> List[Alias] {
    let mut out: List[Alias] = List.new()
    let imps: List[m.Import] = if r.texts.len() > 0 { analysis.imports_in(r.texts[0]) } else { List.new() }
    for x in r.an.refs {
        if x.span.file != 0 || (x.target as usize) >= r.an.symbols.len() { continue }
        let s = r.an.symbols[x.target as usize]
        if s.kind != m.SK_MODULE || !whole_module(s) { continue }
        let mut w = span_text(r, x.span)
        if w.len() == 0 { continue }
        if w[0] == 34 {
            // the import's path: its stem names the module unless an alias follows
            continue
        }
        if !binds_alias(r, imps, x.span) { continue }
        let mut dup = false
        for a in out {
            if bytes.eq(a.name, w) { dup = true }
        }
        if !dup { out.push(Alias(w, s.span.file)) }
    }
    out
}

/// Whether a reference to a module at `sp` (file 0) is a name the module is bound to: an
/// import's alias (or its last segment when it has none), or a use `alias.Name`; not the
/// last segment of `import std.fs as files`, nor the module segment of a namespace use
/// (`bytes` of `std.bytes.eq`, which binds no name `bytes`).
fn binds_alias(r: Res, imps: List[m.Import], sp: m.Span) -> bool {
    for im in imps {
        if im.name.line == sp.line && im.name.col == sp.col { return im.form != m.IM_NAMESPACE }
        if t.contains(im.stmt.line, im.stmt.col, im.stmt.end_line, im.stmt.end_col, sp.line, sp.col) { return false }
    }
    if r.texts.len() == 0 { return true }
    let a = t.offset_of(r.texts[0], r.starts[0], sp.line, sp.col)
    !(a > 0 && r.texts[0][a - 1] == 46)
}

pub fn document_symbols(r: Res) -> List[u8] {
    let n = r.an.symbols.len()
    // children of each symbol (outline symbols of this file only), and which are roots
    let mut first: List[u32] = List.new()
    let mut next: List[u32] = List.new()
    let mut last: List[u32] = List.new()
    let mut has_variants: List[bool] = List.new()
    for i in 0..n {
        first.push(m.NONE)
        next.push(m.NONE)
        last.push(m.NONE)
        has_variants.push(false)
    }
    let mut roots: List[u32] = List.new()
    for i in 0..n {
        let s = r.an.symbols[i]
        if s.span.file != 0 || !outline(s.kind) || whole_module(s) { continue }
        let c = s.container
        let parented = c != m.NONE && (c as usize) < n && r.an.symbols[c as usize].span.file == 0 && outline(r.an.symbols[c as usize].kind)
        if parented {
            if s.kind == m.SK_VARIANT { has_variants[c as usize] = true }
            if first[c as usize] == m.NONE {
                first[c as usize] = i as u32
            } else {
                next[last[c as usize] as usize] = i as u32
            }
            last[c as usize] = i as u32
        } else {
            roots.push(i as u32)
        }
    }
    let mut o = sys.lit("[")
    for x in roots { sym_json(inout o, r, x, first, next, has_variants, 0) }
    o.push(93)
    o
}

fn sym_json(inout o: List[u8], r: Res, i: u32, first: List[u32], next: List[u32], variants: List[bool], depth: u32) {
    let s = r.an.symbols[i as usize]
    rpc.sep(inout o)
    o.push(123)
    let mut name = s.name.copy()
    if s.kind == m.SK_TEST {
        name = sys.lit("test ")
        json.quote_into(inout name, s.name)
    }
    rpc.kv_str(inout o, "name", name)
    if s.detail.len() > 0 { rpc.kv_str(inout o, "detail", s.detail) }
    rpc.kv_num(inout o, "kind", symbol_kind(s.kind, variants[i as usize]))
    rpc.key(inout o, "range")
    // the range must contain the selection range
    let mut full = s.full.copy()
    if full.file != s.span.file || t.pack(full.line, full.col) > t.pack(s.span.line, s.span.col) || t.pack(full.end_line, full.end_col) < t.pack(s.span.end_line, s.span.end_col) { full = s.span }
    range_json(inout o, r, full)
    rpc.key(inout o, "selectionRange")
    range_json(inout o, r, s.span)
    let mut c = first[i as usize].copy()
    if c != m.NONE && depth < 16 {
        bytes.append(inout o, sys.lit(",\"children\":["))
        while c != m.NONE {
            sym_json(inout o, r, c, first, next, variants, depth + 1)
            c = next[c as usize]
        }
        o.push(93)
    }
    o.push(125)
}

// ---- folding ranges

pub fn folding(r: Res) -> List[u8] {
    let mut o = sys.lit("[")
    for s in r.an.symbols {
        let f = s.full
        if f.file != 0 || f.end_line <= f.line || !outline(s.kind) || whole_module(s) { continue }
        rpc.sep(inout o)
        o.push(123)
        rpc.kv_num(inout o, "startLine", (f.line - 1) as u64)
        rpc.kv_num(inout o, "endLine", (f.end_line - 1) as u64)
        o.push(125)
    }
    // runs of import statements on consecutive lines spanning two or more lines (a group
    // across lines, `import std.{` ... `}`, is one statement)
    let mut run_start: u32 = 0
    let mut run_end: u32 = 0
    if r.texts.len() > 0 {
        let mut prev: u32 = 0
        for im in analysis.imports_in(r.texts[0]) {
            // a group's members share the statement
            if im.stmt.line == prev { continue }
            prev = im.stmt.line
            if run_end > 0 && im.stmt.line == run_end + 1 {
                run_end = im.stmt.end_line
            } else {
                folding_imports(inout o, run_start, run_end)
                run_start = im.stmt.line
                run_end = im.stmt.end_line
            }
        }
    }
    folding_imports(inout o, run_start, run_end)
    o.push(93)
    o
}

fn folding_imports(inout o: List[u8], a: u32, b: u32) {
    if a == 0 || b <= a { return }
    rpc.sep(inout o)
    o.push(123)
    rpc.kv_num(inout o, "startLine", (a - 1) as u64)
    rpc.kv_num(inout o, "endLine", (b - 1) as u64)
    rpc.kv_str(inout o, "kind", sys.lit("imports"))
    o.push(125)
}

// ---- semantic tokens

/// The legend: token types and modifiers, in index order.
pub fn legend() -> List[u8] {
    sys.lit("{{\"tokenTypes\":[\"namespace\",\"type\",\"enumMember\",\"property\",\"function\",\"method\",\"parameter\",\"variable\",\"interface\",\"enum\"],\"tokenModifiers\":[\"declaration\",\"readonly\"]}}")
}

/// The token type index for a symbol kind, or NONE (tests aren't highlighted).
fn token_type(k: u32) -> u32 {
    if k == m.SK_MODULE { return 0 }
    if k == m.SK_TYPE { return 1 }
    if k == m.SK_VARIANT { return 2 }
    if k == m.SK_FIELD { return 3 }
    if k == m.SK_FN { return 4 }
    if k == m.SK_METHOD { return 5 }
    if k == m.SK_PARAM { return 6 }
    if k == m.SK_LOCAL || k == m.SK_CONST { return 7 }
    if k == m.SK_TRAIT { return 8 }
    m.NONE
}

/// Bottom-up merge sort.
pub fn sort_u64(xs: List[u64]) -> List[u64] {
    let n = xs.len()
    let mut a = xs.copy()
    let mut b = xs.copy()
    let mut width: usize = 1
    while width < n {
        let mut i: usize = 0
        while i < n {
            let mid = if i + width < n { i + width } else { n }
            let hi = if i + 2 * width < n { i + 2 * width } else { n }
            let mut x = i.copy()
            let mut y = mid.copy()
            let mut k = i.copy()
            while k < hi {
                if x < mid && (y >= hi || a[x] <= a[y]) {
                    b[k] = a[x]
                    x += 1
                } else {
                    b[k] = a[y]
                    y += 1
                }
                k += 1
            }
            i = hi
        }
        let tmp = a.copy()
        a = b
        b = tmp
        width = width * 2
    }
    a
}

pub fn semantic_tokens(r: Res) -> List[u8] {
    if r.texts.len() == 0 { return sys.lit("{{\"data\":[]}}") }
    // candidates: (span, type, modifiers) packed for sorting by position
    let mut spans: List[m.Span] = List.new()
    let mut kinds: List[u32] = List.new()
    let mut keys: List[u64] = List.new()
    for s in r.an.symbols {
        if s.span.file != 0 || s.span.line != s.span.end_line { continue }
        let tt = token_type(s.kind)
        if tt == m.NONE { continue }
        let mut mods: u32 = 1
        if s.kind == m.SK_CONST { mods = 3 }
        add_token(inout spans, inout kinds, inout keys, s.span, tt * 4 + mods)
    }
    for x in r.an.refs {
        if x.span.file != 0 || x.span.line != x.span.end_line || (x.target as usize) >= r.an.symbols.len() { continue }
        let k = r.an.symbols[x.target as usize].kind
        let tt = token_type(k)
        if tt == m.NONE { continue }
        // an import's path is a string, not a name
        if k == m.SK_MODULE {
            let w = span_text(r, x.span)
            if w.len() > 0 && w[0] == 34 { continue }
        }
        let mods: u32 = if k == m.SK_CONST { 2 } else { 0 }
        add_token(inout spans, inout kinds, inout keys, x.span, tt * 4 + mods)
    }
    let sorted = sort_u64(keys)
    let text = r.texts[0]
    let starts = r.starts[0]
    let mut o = sys.lit("{{\"data\":[")
    let mut prev_line: u32 = 0
    let mut prev_ch: u32 = 0
    let mut prev_key: u64 = 0
    let mut any = false
    for key in sorted {
        let pos_key = key / 1048576
        if any && pos_key == prev_key { continue }
        let idx = (key % 1048576) as usize
        let sp = spans[idx]
        let a = t.offset_of(text, starts, sp.line, sp.col)
        let b = t.offset_of(text, starts, sp.end_line, sp.end_col)
        if b <= a { continue }
        let start = t.pos_of_offset(text, starts, a)
        let len = t.units_between(text, a, b)
        let dl = start.line - prev_line
        let dc = if dl == 0 { start.ch - prev_ch } else { start.ch }
        if any { o.push(44) }
        bytes.append(inout o, rpc.num(dl as u64))
        o.push(44)
        bytes.append(inout o, rpc.num(dc as u64))
        o.push(44)
        bytes.append(inout o, rpc.num(len as u64))
        o.push(44)
        bytes.append(inout o, rpc.num((kinds[idx] / 4) as u64))
        o.push(44)
        bytes.append(inout o, rpc.num((kinds[idx] % 4) as u64))
        prev_line = start.line
        prev_ch = start.ch
        prev_key = pos_key
        any = true
    }
    bytes.append(inout o, sys.lit(r"]}"))
    o
}

fn add_token(inout spans: List[m.Span], inout kinds: List[u32], inout keys: List[u64], s: m.Span, k: u32) {
    if spans.len() >= 1048575 { return }
    let idx = spans.len() as u64
    spans.push(s)
    kinds.push(k)
    keys.push(((s.line as u64) * 1048576 + (s.col as u64)) * 1048576 + idx)
}

// ---- completion

fn completion_kind(k: u32) -> u64 {
    if k == m.SK_MODULE { return 9 }
    if k == m.SK_TYPE { return 22 }
    if k == m.SK_VARIANT { return 20 }
    if k == m.SK_FIELD { return 5 }
    if k == m.SK_FN { return 3 }
    if k == m.SK_METHOD { return 2 }
    if k == m.SK_CONST { return 21 }
    if k == m.SK_TRAIT { return 8 }
    6
}

fn item_json(inout o: List[u8], label: List[u8], kind: u64, detail: List[u8]) {
    rpc.sep(inout o)
    o.push(123)
    rpc.kv_str(inout o, "label", label)
    rpc.kv_num(inout o, "kind", kind)
    if detail.len() > 0 { rpc.kv_str(inout o, "detail", detail) }
    o.push(125)
}

fn contains_name(xs: List[List[u8]], x: List[u8]) -> bool {
    for y in xs {
        if bytes.eq(y, x) { return true }
    }
    false
}

/// Completion at `p` in the document's current `text` (which may be newer than the
/// analysis: the receiver before a `.` is looked up by name). `path` is the document's
/// file (module paths are completed from its package).
pub fn completion(r: Res, path: List[u8], text: List[u8], starts: List[u32], p: t.Pos) -> List[u8] uses io, fs {
    let off = t.offset_of_pos(text, starts, p)
    // the identifier prefix being typed
    let mut a = off.copy()
    while a > 0 && bytes.is_ident(text[a - 1]) { a -= 1 }
    let prefix = bytes.slice(text, a, off)
    let mut o = sys.lit("{{\"isIncomplete\":false,\"items\":[")
    let mut seen: List[List[u8]] = List.new()
    let pc = path_context(text, a)
    let an = attr_context(text, a)
    if an.len() > 0 {
        // a key of an attribute (eider-lang docs/compiler.md, "C8.40"): `@[json(na|`
        attr_keys(inout o, inout seen, r, an, prefix)
    } else if pc.found {
        // a module path: after `import `, `import a.`, or in a group's `{ }`
        if !pc.alias {
            let names = if pc.segs.len() == 0 { analysis.import_heads(path) } else { analysis.modules_below(path, pc.segs) }
            for x in names {
                if bytes.starts_with(x.name, prefix) && !contains_name(seen, x.name) {
                    seen.push(x.name)
                    let kind: u64 = if x.kind == analysis.MN_DIR { 19 } else { 9 }
                    item_json(inout o, x.name, kind, x.detail)
                }
            }
        }
    } else if a > 0 && text[a - 1] == 46 {
        // `recv.`: the receiver's name
        let mut b = a - 1
        while b > 0 && bytes.is_ident(text[b - 1]) { b -= 1 }
        let recv = bytes.slice(text, b, a - 1)
        // through a package namespace (docs/compiler.md, "C8.26"): `std.` its modules,
        // `std.time.` the module's items
        let mut ns: List[u8] = List.new()
        let mut head: List[u8] = List.new()
        let mut c = b.copy()
        if b > 0 && text[b - 1] == 46 {
            c = b - 1
            while c > 0 && bytes.is_ident(text[c - 1]) { c -= 1 }
            if !(c > 0 && text[c - 1] == 46) { head = namespace_of(text, bytes.slice(text, c, b - 1)) }
        } else {
            ns = namespace_of(text, recv)
        }
        if ns.len() > 0 {
            let mut segs: List[List[u8]] = List.new()
            segs.push(ns)
            for x in analysis.modules_below(path, segs) {
                if bytes.starts_with(x.name, prefix) && !contains_name(seen, x.name) {
                    seen.push(x.name)
                    let kind: u64 = if x.kind == analysis.MN_DIR { 19 } else { 9 }
                    item_json(inout o, x.name, kind, x.detail)
                }
            }
        } else if head.len() > 0 {
            let mut mp = head.copy()
            mp.push(47)
            bytes.append(inout mp, recv)
            let file = analysis.dotted_file(analysis.package_of(path), path, mp)
            for i in 1..r.an.files.len() {
                if bytes.eq(r.an.files[i], file) { module_items(inout o, inout seen, r, i as u32, prefix) }
            }
        } else {
            members(inout o, inout seen, r, recv, prefix, (t.pos_of_offset(text, starts, b)).line + 1)
        }
    } else {
        visible(inout o, inout seen, r, prefix, p.line + 1)
        for k in keywords() {
            if bytes.starts_with(k, prefix) && !contains_name(seen, k) { item_json(inout o, k, 14, List.new()) }
        }
    }
    bytes.append(inout o, sys.lit(r"]}"))
    o
}

/// Whether an attribute's name starts at offset `k`: right after `@[`, or after a `,` of the
/// group `@[a(...), |` (docs/compiler.md, "C8.60").
fn in_group_head(text: List[u8], k: usize) -> bool {
    let mut j = k.copy()
    while j > 0 && (text[j - 1] == 32 || text[j - 1] == 9 || text[j - 1] == 10 || text[j - 1] == 13) { j -= 1 }
    if j == 0 { return false }
    if text[j - 1] == 91 { return j > 1 && text[j - 2] == 64 }
    if text[j - 1] != 44 { return false }
    // back over the earlier members of the group to its `@[`
    let mut depth: u32 = 0
    j -= 1
    while j > 0 {
        let ch = text[j - 1]
        if ch == 41 { depth += 1 }
        if ch == 40 {
            if depth == 0 { return false }
            depth -= 1
        }
        if depth == 0 {
            if ch == 91 { return j > 1 && text[j - 2] == 64 }
            if ch == 93 || ch == 123 || ch == 125 || ch == 59 { return false }
        }
        j -= 1
    }
    false
}

/// When offset `a` (the start of the identifier being typed) is where a key of an attribute
/// goes, `@[name(` or `@[alias.name(` (or after a `,` of the group) then keys and values up to
/// a `,`: the attribute's name, else empty.
fn attr_context(text: List[u8], a: usize) -> List[u8] {
    let none: List[u8] = List.new()
    let mut j = a.copy()
    while j > 0 && (text[j - 1] == 32 || text[j - 1] == 9 || text[j - 1] == 10 || text[j - 1] == 13) { j -= 1 }
    if j == 0 || (text[j - 1] != 40 && text[j - 1] != 44) { return none }
    // back to the `(` that opens the arguments (no brace or `;` in between)
    let mut depth: u32 = 0
    while j > 0 {
        let ch = text[j - 1]
        if ch == 41 { depth += 1 }
        if ch == 40 {
            if depth == 0 { break }
            depth -= 1
        }
        if ch == 123 || ch == 125 || ch == 59 { return none }
        j -= 1
    }
    if j == 0 { return none }
    let close = j - 1
    let mut b = close.copy()
    while b > 0 && bytes.is_ident(text[b - 1]) { b -= 1 }
    if b == close { return none }
    let name = bytes.slice(text, b, close)
    // `name(` or `alias.name(` at the head of a member of an `@[...]` group
    if in_group_head(text, b) { return name }
    if b > 1 && text[b - 1] == 46 {
        let mut c = b - 1
        while c > 0 && bytes.is_ident(text[c - 1]) { c -= 1 }
        if c < b - 1 && in_group_head(text, c) { return name }
    }
    none
}

/// The keys of attribute `name` (the fields of the record type its `attr` declares) that
/// start with `prefix`.
fn attr_keys(inout o: List[u8], inout seen: List[List[u8]], r: Res, name: List[u8], prefix: List[u8]) {
    for x in r.an.symbols {
        if x.kind != m.SK_FIELD || x.container == m.NONE || (x.container as usize) >= r.an.symbols.len() { continue }
        let c = r.an.symbols[x.container as usize]
        if c.kind != m.SK_TYPE || !bytes.eq(c.name, name) { continue }
        if bytes.starts_with(x.name, prefix) && !contains_name(seen, x.name) {
            seen.push(x.name)
            item_json(inout o, x.name, 10, x.detail)
        }
    }
}

/// Where a module path is typed (`found`): `segs` the segments before the one being typed,
/// including a group's prefix (`import std.{bytes, f` -> [std]); `alias` when it is an
/// `as` name instead (nothing to complete).
type PathCtx = { found: bool, segs: List[List[u8]], alias: bool }

/// Whether offset `a` (the start of the identifier being typed) is in a module path of an
/// import: `import |`, `import a.b.|`, `import a.{x, b.|` (a group across lines too).
fn path_context(text: List[u8], a: usize) -> PathCtx {
    let none = PathCtx(false, List.new(), false)
    // the segments typed before: `a.b.`
    let sb = segments_before(text, a)
    if !sb.found { return none }
    let segs = sb.segs
    // `import ` at the start of the line
    let mut k = sb.at.copy()
    while k > 0 && (text[k - 1] == 32 || text[k - 1] == 9) { k -= 1 }
    if import_kw_before(text, k) { return PathCtx(true, segs, false) }
    // an alias being typed: `import std.fs as |`, `fs as |` in a group
    let alias = segs.len() == 0 && word_before(text, k, "as")
    if alias {
        k -= 2
        let mut j = k.copy()
        while j > 0 && text[j - 1] != 10 { j -= 1 }
        let line = bytes.trim(bytes.slice(text, j, k))
        if bytes.starts_with(line, sys.lit("import ")) && bytes.find_byte(line, 123, 0).is_none() { return PathCtx(true, segs, true) }
    }
    // in a group: back over members (`x, b.c as d,`) to an unclosed `{` after `import a.`
    while k > 0 {
        let ch = text[k - 1]
        if ch == 123 { break }
        if !(bytes.is_ident(ch) || ch == 46 || ch == 44 || bytes.is_space(ch)) { return none }
        k -= 1
    }
    if k < 2 || text[k - 2] != 46 { return none }
    // the group's prefix
    let pb = segments_before(text, k - 1)
    if !pb.found || pb.segs.len() == 0 { return none }
    let mut e = pb.at.copy()
    while e > 0 && (text[e - 1] == 32 || text[e - 1] == 9) { e -= 1 }
    if !import_kw_before(text, e) { return none }
    let mut pre = pb.segs.copy()
    for x in segs { pre.push(x) }
    PathCtx(true, pre, alias)
}

/// The segments `a.b.` before offset `at` (each an identifier followed by `.`), in order,
/// and the offset where the first starts; not `found` when a `.` has no identifier before it.
type Segs = { found: bool, segs: List[List[u8]], at: usize }

fn segments_before(text: List[u8], at: usize) -> Segs {
    let mut rev: List[List[u8]] = List.new()
    let mut b = at.copy()
    while b > 0 && text[b - 1] == 46 {
        let mut c = b - 1
        while c > 0 && bytes.is_ident(text[c - 1]) { c -= 1 }
        if c == b - 1 { return Segs(false, List.new(), at) }
        rev.push(bytes.slice(text, c, b - 1))
        b = c
    }
    let mut segs: List[List[u8]] = List.new()
    let mut i = rev.len()
    while i > 0 {
        i -= 1
        segs.push(rev[i])
    }
    Segs(true, segs, b)
}

/// Whether the text before offset `k` is `import` at the start of a line (after indentation).
fn import_kw_before(text: List[u8], k: usize) -> bool {
    if !word_before(text, k, "import") { return false }
    let mut j = k - 6
    while j > 0 && (text[j - 1] == 32 || text[j - 1] == 9) { j -= 1 }
    j == 0 || text[j - 1] == 10
}

/// Whether the word before offset `k` is `w` (a whole word).
fn word_before(text: List[u8], k: usize, w: str) -> bool {
    let ww = sys.lit(w)
    if k < ww.len() || !bytes.eq(bytes.slice(text, k - ww.len(), k), ww) { return false }
    let j = k - ww.len()
    j == 0 || !bytes.is_ident(text[j - 1])
}

/// The package a namespace alias `name` stands for in `text` (`std` for `import std`), or empty.
fn namespace_of(text: List[u8], name: List[u8]) -> List[u8] {
    for im in analysis.imports_in(text) {
        if im.form == m.IM_NAMESPACE && bytes.eq(im.alias, name) { return im.path }
    }
    List.new()
}

fn keywords() -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for w in ["fn", "type", "let", "var", "if", "else", "while", "for", "in", "return", "match", "true", "false", "uses", "test",
        "assert", "inout", "as", "const", "break", "continue", "import", "trait", "impl", "pub", "comptime", "extern", "export", "unsafe",
        "self", "Self", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "bool", "str", "String", "List", "Map", "Box",
        "Option", "Result", "Some", "None", "Ok", "Err", "print", "panic", "len", "spawn", "Task", "Mutex", "Chan",
        // since docs/compiler.md C8.4 to C8.23: `let mut`, Ref[T] and the prelude's Ordering and traits
        "mut", "Ref", "Ordering", "Less", "Equal", "Greater", "Copy", "Eq", "Ord", "Hash", "Show", "Iter", "Drop",
        "From", "Default",
        // C8.29: words at the start of a statement
        "defer", "errdefer",
        // comptime reflection (eider-lang docs/compiler.md, "C8.41", "C8.42")
        "fields", "variants", "has_attr", "is_enum_type"] { out.push(sys.lit(w)) }
    out
}

/// Names visible at line `line` of the document: its items, the imported modules' aliases,
/// and the parameters and locals of the function around the line declared before it.
fn visible(inout o: List[u8], inout seen: List[List[u8]], r: Res, prefix: List[u8], line: u32) {
    // the innermost function (or test) whose full span holds the line
    let mut cur = m.NONE
    for i in 0..r.an.symbols.len() {
        let s = r.an.symbols[i]
        if s.full.file == 0 && (s.kind == m.SK_FN || s.kind == m.SK_METHOD || s.kind == m.SK_TEST) && s.full.line <= line && line <= s.full.end_line { cur = i as u32 }
    }
    // locals first (newest first, so the innermost shadowing one wins)
    let mut i = r.an.symbols.len()
    while i > 0 {
        i -= 1
        let s = r.an.symbols[i]
        if s.span.file != 0 || (s.kind != m.SK_LOCAL && s.kind != m.SK_PARAM) { continue }
        if cur == m.NONE || s.container != cur || s.span.line > line { continue }
        if bytes.starts_with(s.name, prefix) && !contains_name(seen, s.name) {
            seen.push(s.name)
            item_json(inout o, s.name, 6, s.detail)
        }
    }
    for a in aliases(r) {
        if bytes.starts_with(a.name, prefix) && !contains_name(seen, a.name) {
            seen.push(a.name)
            item_json(inout o, a.name, 9, List.new())
        }
    }
    // package namespaces (`std` of `import std`), which name no module
    if r.texts.len() > 0 {
        for im in analysis.imports_in(r.texts[0]) {
            if im.form == m.IM_NAMESPACE && bytes.starts_with(im.alias, prefix) && !contains_name(seen, im.alias) {
                seen.push(im.alias)
                let mut d = sys.lit("import ")
                bytes.append(inout d, im.path)
                item_json(inout o, im.alias, 9, d)
            }
        }
    }
    for s in r.an.symbols {
        if s.span.file != 0 || whole_module(s) { continue }
        let item = s.kind == m.SK_MODULE || s.kind == m.SK_TYPE || s.kind == m.SK_VARIANT || s.kind == m.SK_FN || s.kind == m.SK_CONST || s.kind == m.SK_TRAIT
        if !item { continue }
        if bytes.starts_with(s.name, prefix) && !contains_name(seen, s.name) {
            seen.push(s.name)
            item_json(inout o, s.name, completion_kind(s.kind), s.detail)
        }
    }
    // the prelude's types, variants and traits (Option, Ordering, Less, Copy, From, Default, ...)
    let pre = prelude_file(r)
    if pre == 0 { return }
    for s in r.an.symbols {
        if s.span.file != pre || whole_module(s) { continue }
        if !(s.kind == m.SK_TYPE || s.kind == m.SK_VARIANT || s.kind == m.SK_TRAIT) { continue }
        if bytes.starts_with(s.name, prefix) && !contains_name(seen, s.name) {
            seen.push(s.name)
            item_json(inout o, s.name, completion_kind(s.kind), s.detail)
        }
    }
}

/// The index of core/prelude.ei in the analysis' files, or 0 (none: the lexical stand-in).
fn prelude_file(r: Res) -> u32 {
    for i in 1..r.an.files.len() {
        if bytes.ends_with(r.an.files[i], sys.lit("/core/prelude.ei")) { return i as u32 }
    }
    0
}

/// Members after `recv.`: a module's public items, or the fields and methods of recv's
/// type (by the declared type of the local, parameter, field or constant named recv), or
/// the built-in methods of List, String, Map, Option and Result.
fn members(inout o: List[u8], inout seen: List[List[u8]], r: Res, recv: List[u8], prefix: List[u8], line: u32) {
    // a module alias: from ide.analyze's references to modules, else the lexical
    // fallback's import symbols
    let mut mf: u32 = 0
    for a in aliases(r) {
        if bytes.eq(a.name, recv) { mf = a.file }
    }
    if mf == 0 {
        for s in r.an.symbols {
            if s.kind == m.SK_MODULE && s.span.file == 0 && !whole_module(s) && bytes.eq(s.name, recv) { mf = module_file(r, s) }
        }
    }
    if mf != 0 {
        module_items(inout o, inout seen, r, mf, prefix)
        return
    }
    // the receiver's type: a type name itself (`Point.`), else the type of the nearest
    // declaration named recv
    let mut ty: List[u8] = List.new()
    if recv.len() > 0 && recv[0] >= 65 && recv[0] <= 90 {
        ty = recv
        // `T.default()` (docs/compiler.md, "C8.23"), `E.from(x)` ("C8.21")
        for w in ["default", "from"] {
            let b = sys.lit(w)
            if bytes.starts_with(b, prefix) && !contains_name(seen, b) {
                seen.push(b)
                item_json(inout o, b, 3, List.new())
            }
        }
    } else {
        ty = type_of_name(r, recv, line)
    }
    let head = type_head(ty)
    if head.len() == 0 { return }
    // fields and methods whose container is a type with that name
    for x in r.an.symbols {
        if x.kind != m.SK_FIELD && x.kind != m.SK_METHOD { continue }
        if x.container == m.NONE || (x.container as usize) >= r.an.symbols.len() { continue }
        let c = r.an.symbols[x.container as usize]
        if c.kind != m.SK_TYPE || !bytes.eq(c.name, head) { continue }
        if bytes.starts_with(x.name, prefix) && !contains_name(seen, x.name) {
            seen.push(x.name)
            item_json(inout o, x.name, completion_kind(x.kind), x.detail)
        }
    }
    // the methods of a trait this file implements for the type: its default methods are
    // inherited (eider-lang's docs/compiler.md, "C8.31")
    if r.texts.len() > 0 {
        for x in r.an.symbols {
            if x.kind != m.SK_METHOD || x.container == m.NONE || (x.container as usize) >= r.an.symbols.len() { continue }
            let c = r.an.symbols[x.container as usize]
            if c.kind != m.SK_TRAIT || !bytes.starts_with(x.name, prefix) || contains_name(seen, x.name) { continue }
            let mut needle = sys.lit("impl ")
            bytes.append(inout needle, c.name)
            bytes.append(inout needle, sys.lit(" for "))
            bytes.append(inout needle, head)
            if bytes.find(r.texts[0], needle, 0).is_some() {
                seen.push(x.name)
                item_json(inout o, x.name, completion_kind(x.kind), x.detail)
            }
        }
    }
    for b in builtin_methods(head) {
        if bytes.starts_with(b, prefix) && !contains_name(seen, b) {
            seen.push(b)
            item_json(inout o, b, 2, List.new())
        }
    }
}

/// The public items of the module in file `mf` that start with `prefix`.
fn module_items(inout o: List[u8], inout seen: List[List[u8]], r: Res, mf: u32, prefix: List[u8]) {
    for x in r.an.symbols {
        if x.span.file != mf { continue }
        let item = x.kind == m.SK_TYPE || x.kind == m.SK_VARIANT || x.kind == m.SK_FN || x.kind == m.SK_CONST || x.kind == m.SK_TRAIT
        if item && public(r, x) && bytes.starts_with(x.name, prefix) && !contains_name(seen, x.name) {
            seen.push(x.name)
            item_json(inout o, x.name, completion_kind(x.kind), x.detail)
        }
    }
}

/// A module item usable from another module: declared `pub` (its detail is its source
/// form), or a variant of a `pub` type.
fn public(r: Res, x: m.Symbol) -> bool {
    let p = sys.lit("pub ")
    if bytes.starts_with(x.detail, p) { return true }
    if x.kind == m.SK_VARIANT && x.container != m.NONE && (x.container as usize) < r.an.symbols.len() {
        return bytes.starts_with(r.an.symbols[x.container as usize].detail, p)
    }
    false
}

/// The file an import's module symbol (the lexical stand-in's) refers to: the analysis file
/// whose stem is the alias is not reliable (aliases), so use the import's path from its
/// detail, `import "path" [as alias]` or `import a.b.c [as alias]` (docs/compiler.md,
/// "C8.26"), as `a/b/c`: the file whose path ends with the most of its components (the
/// package's name is no directory of its own files; `x` and `x.ei` name the same file).
fn module_file(r: Res, s: m.Symbol) -> u32 {
    let d = s.detail
    let mut path: List[u8] = List.new()
    match bytes.find_byte(d, 34, 0) {
        Some(a) => {
            match bytes.find_byte(d, 34, a + 1) {
                Some(b) => { path = bytes.slice(d, a + 1, b) }
                None => { return 0 }
            }
        }
        None => {
            let kw = sys.lit("import ")
            if !bytes.starts_with(d, kw) { return 0 }
            let mut b = kw.len()
            while b < d.len() && (bytes.is_ident(d[b]) || d[b] == 46) {
                let ch: u8 = if d[b] == 46 { 47 } else { d[b] }
                path.push(ch)
                b += 1
            }
        }
    }
    if path.len() == 0 { return 0 }
    if !bytes.ends_with(path, sys.lit(".ei")) { bytes.append(inout path, sys.lit(".ei")) }
    let parts = bytes.split(path, 47)
    let mut best: u32 = 0
    let mut best_n: usize = 0
    for i in 1..r.an.files.len() {
        let fp = bytes.split(r.an.files[i], 47)
        // how many trailing components agree
        let mut n: usize = 0
        while n < parts.len() && n < fp.len() && bytes.eq(parts[parts.len() - 1 - n], fp[fp.len() - 1 - n]) { n += 1 }
        if n > best_n {
            best = i as u32
            best_n = n
        }
    }
    best
}

/// The declared type text of the nearest declaration or reference named `name` in this
/// document, at or before `line` and inside the function around it.
fn type_of_name(r: Res, name: List[u8], line: u32) -> List[u8] {
    let mut best: List[u8] = List.new()
    let mut best_line: u32 = 0
    let mut first: u32 = 0
    for s in r.an.symbols {
        if s.full.file == 0 && (s.kind == m.SK_FN || s.kind == m.SK_METHOD || s.kind == m.SK_TEST) && s.full.line <= line && line <= s.full.end_line { first = s.full.line }
    }
    if first == 0 { return best }
    for x in r.an.types {
        if x.span.file != 0 || x.span.line > line || x.span.line < first || x.span.line < best_line { continue }
        // a type recorded at a declaration or reference named `name`
        if x.span.line == x.span.end_line && x.span.end_col - x.span.col == (name.len() as u32) {
            if r.texts.len() > 0 {
                let a = t.offset_of(r.texts[0], r.starts[0], x.span.line, x.span.col)
                let w = bytes.slice(r.texts[0], a, a + name.len())
                if bytes.eq(w, name) {
                    best = x.text
                    best_line = x.span.line
                }
            }
        }
    }
    best
}

/// `List[Point]` -> `List`, `inout Point` -> `Point`, `g.Point` -> `Point`.
fn type_head(ty: List[u8]) -> List[u8] {
    let mut i: usize = 0
    let mut out: List[u8] = List.new()
    while i < ty.len() {
        while i < ty.len() && !bytes.is_ident(ty[i]) { i += 1 }
        let mut w: List[u8] = List.new()
        while i < ty.len() && bytes.is_ident(ty[i]) {
            w.push(ty[i])
            i += 1
        }
        if w.len() == 0 || bytes.eq(w, sys.lit("inout")) { continue }
        // a qualified name: the last part
        if i < ty.len() && ty[i] == 46 { continue }
        return w
    }
    out
}

/// The built-in methods of a type head (check.ei's `builtin_method` and `builtin_static`,
/// the prelude's Option and Result), then the methods of the language's traits that most
/// types have, derived (docs/compiler.md, "C8.4"), and `take`/`replace` ("C8.15").
fn builtin_methods(head: List[u8]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    if bytes.eq(head, sys.lit("List")) {
        // the in-place operations and slice/filled: eider-lang docs/compiler.md, "C8.49"
        for w in ["len", "push", "pop", "contains", "is_empty", "clear", "get", "sum", "map", "filter", "for_each", "any", "all", "fold", "new", "insert", "remove", "truncate", "extend", "swap", "remove_range", "slice", "filled"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("String")) {
        for w in ["len", "is_empty", "push_str", "push_byte", "append", "byte", "slice", "bytes", "from", "from_int", "from_bytes", "new"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("str")) {
        for w in ["len", "is_empty", "byte", "slice", "bytes"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Map")) {
        // `deterministic`: the fixed-seed hasher (docs/decisions.md C805)
        for w in ["insert", "get", "remove", "contains", "len", "is_empty", "keys", "values", "entries", "new", "deterministic"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Option")) {
        for w in ["is_some", "is_none", "unwrap", "unwrap_or", "map", "and_then", "ok_or"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Result")) {
        for w in ["is_ok", "is_err", "unwrap", "unwrap_or", "map", "map_err"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Ref")) {
        // docs/compiler.md, "C8.7"
        for w in ["get", "set", "read", "update", "new"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Box")) {
        for w in ["get", "set", "new"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Mutex")) {
        for w in ["get", "set", "update", "new"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Chan")) {
        for w in ["send", "recv", "close", "new"] { out.push(sys.lit(w)) }
    } else if bytes.eq(head, sys.lit("Task")) {
        // `catch`: Task.catch(f) contains a trap (docs/compiler.md, "C8.51")
        for w in ["join", "catch"] { out.push(sys.lit(w)) }
    }
    for w in ["copy", "eq", "compare", "hash", "show", "to_string", "take", "replace"] { out.push(sys.lit(w)) }
    out
}

// ---- diagnostics and code actions

/// The LSP range of a diagnostic at (line, col): the identifier there, else one character.
fn diag_range(inout o: List[u8], r: Res, file: u32, line: u32, col: u32) {
    let f = file as usize
    if f >= r.texts.len() || r.texts[f].len() == 0 {
        range_json(inout o, r, m.Span(file, line, col, line, col + 1))
        return
    }
    let text = r.texts[f]
    let starts = r.starts[f]
    let a = t.offset_of(text, starts, line, col)
    let mut b = a.copy()
    while b < text.len() && t.ident_byte(text[b]) {
        b += 1
    }
    if b == a && a < text.len() && text[a] != 10 {
        b = a + 1
        while b < text.len() && text[b] >= 128 && text[b] < 192 { b += 1 }
    }
    bytes.append(inout o, sys.lit("{{\"start\":"))
    pos_json(inout o, t.pos_of_offset(text, starts, a))
    bytes.append(inout o, sys.lit(",\"end\":"))
    pos_json(inout o, t.pos_of_offset(text, starts, b))
    o.push(125)
}

fn diag_json(inout o: List[u8], r: Res, d: m.Diag) {
    o.push(123)
    rpc.key(inout o, "range")
    diag_range(inout o, r, d.file, d.line, d.col)
    rpc.kv_num(inout o, "severity", d.sev as u64)
    rpc.kv_str(inout o, "code", d.code)
    rpc.kv_str(inout o, "source", sys.lit("eider"))
    let mut msg = d.msg.copy()
    if d.help.len() > 0 {
        bytes.append(inout msg, sys.lit("\nhelp: "))
        bytes.append(inout msg, d.help)
    }
    rpc.kv_str(inout o, "message", msg)
    o.push(125)
}

/// The diagnostics of file `file` as a JSON array.
pub fn diagnostics(r: Res, file: u32) -> List[u8] {
    let mut o = sys.lit("[")
    for d in r.an.diags {
        if d.file != file { continue }
        rpc.sep(inout o)
        diag_json(inout o, r, d)
    }
    o.push(93)
    o
}

/// The files with diagnostics (as indexes).
pub fn diag_files(r: Res) -> List[u32] {
    let mut out: List[u32] = List.new()
    for d in r.an.diags {
        let mut dup = false
        for f in out {
            if f == d.file { dup = true }
        }
        if !dup { out.push(d.file) }
    }
    out
}

/// Quick fixes: every diagnostic of the document with a machine-applicable fix whose line
/// is in [first_line, last_line] (0-based LSP lines).
pub fn code_actions(r: Res, first_line: u32, last_line: u32) -> List[u8] {
    let mut o = sys.lit("[")
    if r.texts.len() == 0 { return sys.lit("[]") }
    let text = r.texts[0]
    let starts = r.starts[0]
    for d in r.an.diags {
        if d.file != 0 { continue }
        let f = match d.fix {
            Some(x) => x
            None => { continue }
        }
        let dl: u32 = if d.line > 0 { d.line - 1 } else { 0 }
        let fl: u32 = if f.line > 0 { f.line - 1 } else { 0 }
        let near = (dl >= first_line && dl <= last_line) || (fl >= first_line && fl <= last_line)
        if !near { continue }
        let a = t.offset_of(text, starts, f.line, f.col)
        let mut b = a + (f.delete as usize)
        if f.delete > (text.len() as u64) || b > text.len() { b = text.len() }
        rpc.sep(inout o)
        o.push(123)
        let mut title = sys.lit("Apply the compiler's fix: ")
        if f.insert.len() > 0 && b == a {
            bytes.append(inout title, sys.lit("insert `"))
            bytes.append(inout title, bytes.trim(f.insert))
            title.push(96)
        } else if f.insert.len() == 0 {
            bytes.append(inout title, sys.lit("delete `"))
            bytes.append(inout title, bytes.slice(text, a, b))
            title.push(96)
        } else {
            bytes.append(inout title, sys.lit("replace `"))
            bytes.append(inout title, bytes.slice(text, a, b))
            bytes.append(inout title, sys.lit("` with `"))
            bytes.append(inout title, f.insert)
            title.push(96)
        }
        rpc.kv_str(inout o, "title", title)
        rpc.kv_str(inout o, "kind", sys.lit("quickfix"))
        rpc.kv_raw(inout o, "isPreferred", sys.lit("true"))
        rpc.key(inout o, "diagnostics")
        o.push(91)
        diag_json(inout o, r, d)
        o.push(93)
        rpc.key(inout o, "edit")
        bytes.append(inout o, sys.lit("{{\"changes\":{{"))
        json.quote_into(inout o, r.uri)
        bytes.append(inout o, sys.lit(":[{{\"range\":{{\"start\":"))
        pos_json(inout o, t.pos_of_offset(text, starts, a))
        bytes.append(inout o, sys.lit(",\"end\":"))
        pos_json(inout o, t.pos_of_offset(text, starts, b))
        bytes.append(inout o, sys.lit("}},\"newText\":"))
        json.quote_into(inout o, f.insert)
        bytes.append(inout o, sys.lit(r"}]}}"))
        o.push(125)
    }
    o.push(93)
    o
}
