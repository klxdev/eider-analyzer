// lsp_standin: a lexical stand-in for compiler/ide.ei's symbols, references and types.
//
// When the entry file lexes but does not parse, ide.analyze has no symbols; then the adapter
// (lsp_analysis.ei) lexes the files with the compiler's own lexer (positions are exactly the
// compiler's) and hands the tokens here. This module
// recognises declarations in the token stream and resolves names by scope, without the type
// checker:
//
// - declarations: imports (module aliases), types, record fields, variants and their named
//   fields, functions, methods (in `impl` and `trait` blocks), constants, traits, tests,
//   parameters (also of closures), `let`/`var` locals (also tuple and variant patterns),
//   `for` variables and match-arm bindings;
// - references: a name resolves to the innermost local declared before it whose block is
//   still open, else to an item of the file; `alias.Name` to the imported module's public
//   item; `x.f` to a field or method of x's type when it is known (from an annotation, a
//   `Type(...)`/`Type.f(...)` initialiser, or `self` in an impl), else to the only field or
//   method of that name;
// - types: the annotation of parameters, fields, constants and locals, recorded at the
//   declaration and at every reference to it.
//
// It never fails: syntax it doesn't recognise is skipped. Only the entry file gets locals and
// references; imported files contribute their items (one level of imports).

import "deps/core/sys.ei"
import "deps/std/bytes.ei"
import "lsp_model.ei" as m

pub const TK_IDENT: u32 = 1
pub const TK_STR: u32 = 2
pub const TK_INT: u32 = 3
pub const TK_NL: u32 = 4
pub const TK_EOF: u32 = 5
pub const TK_PUNCT: u32 = 6

/// One token. `sym` is the interned identifier (TK_IDENT) or the index of the decoded
/// string in `File.strs` (TK_STR); `p` the punctuation as up to two bytes (a * 256 + b).
pub type Tok = { kind: u32, sym: u32, p: u32, start: u32, end: u32, line: u32, col: u32, end_col: u32 }

/// A lexed file. Every file of one analysis is lexed with one interner, so a name id means
/// the same name everywhere; keyword ids are the compiler's (intern.ei: 0..30, then `_` 31,
/// `self` 32, `Self` 33).
pub type File = { id: u32, src: List[u8], toks: List[Tok], strs: List[List[u8]] }

const K_FN: u32 = 0
const K_TYPE: u32 = 1
const K_LET: u32 = 2
const K_VAR: u32 = 3
const K_IF: u32 = 4
const K_FOR: u32 = 7
const K_IN: u32 = 8
const K_USES: u32 = 13
const K_TEST: u32 = 14
const K_INOUT: u32 = 16
const K_AS: u32 = 17
const K_CONST: u32 = 18
const K_IMPORT: u32 = 23
const K_TRAIT: u32 = 24
const K_IMPL: u32 = 25
const K_PUB: u32 = 26
const K_COMPTIME: u32 = 27
const K_EXTERN: u32 = 28
const K_EXPORT: u32 = 29
const K_UNSAFE: u32 = 30
const LAST_KEYWORD: u32 = 30
const S_UNDERSCORE: u32 = 31
const S_SELF: u32 = 32
const S_SELF_TYPE: u32 = 33

const P_LBRACE: u32 = 123
const P_RBRACE: u32 = 125
const P_LPAREN: u32 = 40
const P_RPAREN: u32 = 41
const P_LBRACK: u32 = 91
const P_RBRACK: u32 = 93
const P_COLON: u32 = 58
const P_COMMA: u32 = 44
const P_DOT: u32 = 46
const P_PIPE: u32 = 124
const P_EQ: u32 = 61
const P_ARROW: u32 = 11582
const P_FATARROW: u32 = 15678

const OPEN: u32 = 4294967295

/// What the scans produce. Symbol indexes are global across the files of one analysis.
/// Per symbol: `sym_type` its type text (empty if unknown), `type_tn` the name id of that
/// type's head (`List` for `List[Point]`), `owner_tn` the name id of the type
/// a field or method belongs to, `name_id` its name, `public`, and `next_member` chaining
/// fields and methods with the same name (`members` holds each chain's head). `top` maps
/// file * 2^32 + name id to the file's items.
pub type Out = {
    symbols: List[m.Symbol],
    refs: List[m.Ref],
    types: List[m.TypeAt],
    sym_type: List[List[u8]],
    type_tn: List[u32],
    owner_tn: List[u32],
    name_id: List[u32],
    public: List[bool],
    next_member: List[u32],
    members: Map[u32, u32],
    top: Map[u64, u32],
}

pub fn new_out() -> Out {
    var mem: Map[u32, u32] = Map.new()
    var top: Map[u64, u32] = Map.new()
    Out(List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), mem, top)
}

/// An import in a file: the path as written and the module symbol.
pub type Import = { path: List[u8], sym: u32, alias: u32 }

/// An imported module the adapter scanned: the alias's name id and the module's file id.
pub type ModFile = { alias: u32, file: u32 }

/// A local or parameter of the entry file: visible after token `from` up to token `until`;
/// `prev` chains to the previous local with the same name.
type Local = { sym: u32, from: u32, until: u32, prev: u32, ctx: u32 }

/// An open brace: what it opens, the symbol that owns it (a function, test or trait), the
/// container for methods declared in it, and the name id of the type `self` has there.
type Ctx = { kind: u32, owner: u32, target: u32, tname: u32 }

const C_TOP: u32 = 0
const C_FN: u32 = 1
const C_BLOCK: u32 = 2
const C_IMPL: u32 = 3
const C_TRAIT: u32 = 4

type St = {
    f: File,
    names: List[List[u8]],
    entry: bool,
    i: usize,
    out: Out,
    ctx: List[Ctx],
    locals: List[Local],
    /// name id -> the newest local with that name
    local_head: Map[u32, u32],
    /// token indexes that are declaration names (not references)
    decl_tok: Map[u32, bool],
    imports: List[Import],
    /// methods of `impl` blocks waiting for their type: method symbol * 2^32 + type name id
    pend: List[u64],
}

// ---- tokens

fn tk(s: St, i: usize) -> Tok {
    if i < s.f.toks.len() { return s.f.toks[i] }
    s.f.toks[s.f.toks.len() - 1]
}

fn kind_at(s: St, i: usize) -> u32 {
    if i < s.f.toks.len() { return s.f.toks[i].kind }
    TK_EOF
}

fn is_p(s: St, i: usize, p: u32) -> bool {
    if i >= s.f.toks.len() { return false }
    let t = s.f.toks[i]
    t.kind == TK_PUNCT && t.p == p
}

fn is_kw(s: St, i: usize, k: u32) -> bool {
    if i >= s.f.toks.len() { return false }
    let t = s.f.toks[i]
    t.kind == TK_IDENT && t.sym == k
}

/// An identifier that isn't a keyword or `_` (`self` and `Self` are names).
fn is_name(s: St, i: usize) -> bool {
    if i >= s.f.toks.len() { return false }
    let t = s.f.toks[i]
    t.kind == TK_IDENT && t.sym > LAST_KEYWORD && t.sym != S_UNDERSCORE
}

/// A name starting with a lowercase letter or `_` (a binding rather than a type/variant).
fn is_lower(s: St, i: usize) -> bool {
    if !is_name(s, i) { return false }
    let n = s.names[tk(s, i).sym as usize]
    n.len() > 0 && !(n[0] >= 65 && n[0] <= 90)
}

fn is_upper(s: St, i: usize) -> bool { is_name(s, i) && !is_lower(s, i) }

fn name_of(s: St, i: usize) -> List[u8] {
    let t = tk(s, i)
    if t.kind == TK_IDENT { return s.names[t.sym as usize] }
    if t.kind == TK_STR { return s.f.strs[t.sym as usize] }
    List.new()
}

fn tspan(s: St, i: usize) -> m.Span {
    let t = tk(s, i)
    m.Span(s.f.id, t.line, t.col, t.line, t.end_col)
}

/// From the start of token a to the end of token b.
fn range(s: St, a: usize, b: usize) -> m.Span {
    let x = tk(s, a)
    let y = tk(s, b)
    m.Span(s.f.id, x.line, x.col, y.line, y.end_col)
}

/// Source text from the start of token a to the end of token b.
fn text(s: St, a: usize, b: usize) -> List[u8] {
    let x = tk(s, a)
    let y = tk(s, b)
    if y.end < x.start { return List.new() }
    bytes.slice(s.f.src, x.start as usize, y.end as usize)
}

/// `text` with every run of whitespace made one space (for one-line details).
fn flat(s: St, a: usize, b: usize) -> List[u8] {
    let raw = text(s, a, b)
    var out: List[u8] = List.new()
    var space = false
    for c in raw {
        if c == 10 || c == 13 || c == 9 || c == 32 {
            space = true
        } else {
            if space && out.len() > 0 { out.push(32) }
            space = false
            out.push(c)
        }
    }
    out
}

fn skip_nl(s: St, i: usize) -> usize {
    var j = i
    while kind_at(s, j) == TK_NL { j += 1 }
    j
}

/// The token closing the bracket opened at `i` (or the last token).
fn closing(s: St, i: usize) -> usize {
    var depth: i32 = 0
    var j = i
    while j < s.f.toks.len() {
        let t = s.f.toks[j]
        if t.kind == TK_EOF { return j }
        if t.kind == TK_PUNCT {
            if t.p == P_LPAREN || t.p == P_LBRACK || t.p == P_LBRACE { depth += 1 }
            if t.p == P_RPAREN || t.p == P_RBRACK || t.p == P_RBRACE {
                depth -= 1
                if depth == 0 { return j }
            }
        }
        j += 1
    }
    s.f.toks.len() - 1
}

/// The last token of a type starting at `i` (a `,`, `)`, `}`, `]`, `=`, `{`, `|`, newline
/// or `uses` at bracket depth 0 ends it).
fn type_end(s: St, i: usize) -> usize {
    var depth: i32 = 0
    var j = i
    var last = i
    while j < s.f.toks.len() {
        let t = s.f.toks[j]
        if t.kind == TK_EOF { break }
        if depth == 0 {
            if t.kind == TK_NL { break }
            if t.kind == TK_IDENT && t.sym == K_USES { break }
            if t.kind == TK_PUNCT && (t.p == P_COMMA || t.p == P_RPAREN || t.p == P_RBRACE || t.p == P_EQ || t.p == P_LBRACE || t.p == P_PIPE || t.p == P_RBRACK) { break }
        }
        if t.kind == TK_PUNCT {
            if t.p == P_LPAREN || t.p == P_LBRACK { depth += 1 }
            if t.p == P_RPAREN || t.p == P_RBRACK { depth -= 1 }
        }
        last = j
        j += 1
    }
    last
}

/// The head name of the type in tokens a..b (`List` for `List[Point]`, `Point` for
/// `g.Point`), or NONE.
fn head_of(s: St, a: usize, b: usize) -> u32 {
    var j = a
    while j <= b {
        if is_name(s, j) {
            if j + 2 <= b && is_p(s, j + 1, P_DOT) && is_name(s, j + 2) { return tk(s, j + 2).sym }
            return tk(s, j).sym
        }
        j += 1
    }
    m.NONE
}

/// The last token on the line of token `i`.
fn line_end_tok(s: St, i: usize) -> usize {
    var j = i
    while j + 1 < s.f.toks.len() {
        let t = s.f.toks[j + 1]
        if t.kind == TK_NL || t.kind == TK_EOF { break }
        j += 1
    }
    j
}

// ---- recording

/// A declaration named by token `at`. `ty`/`tn`: its type text and head name id; `own`: the
/// name id of the type it is a member of (fields and methods).
fn add_sym(inout s: St, kind: u32, at: usize, full: m.Span, container: u32, detail: List[u8], ty: List[u8], tn: u32, own: u32, public: bool) -> u32 {
    let sp = tspan(s, at)
    let name_id = tk(s, at).sym
    s.out.symbols.push(m.Symbol(name_of(s, at), kind, sp, full, container, detail))
    s.out.sym_type.push(ty)
    s.out.type_tn.push(tn)
    s.out.owner_tn.push(own)
    let nid = if kind_at(s, at) == TK_IDENT { name_id } else { m.NONE }
    s.out.name_id.push(nid)
    s.out.public.push(public)
    s.out.next_member.push(m.NONE)
    let id = (s.out.symbols.len() - 1) as u32
    s.decl_tok.insert(at as u32, true)
    if ty.len() > 0 && kind != m.SK_FN && kind != m.SK_METHOD { s.out.types.push(m.TypeAt(sp, ty)) }
    if kind == m.SK_FIELD || kind == m.SK_METHOD {
        let prev = match s.out.members.get(name_id) {
            Some(x) => x
            None => m.NONE
        }
        s.out.next_member[id as usize] = prev
        s.out.members.insert(name_id, id)
    }
    let item = kind == m.SK_TYPE || kind == m.SK_VARIANT || kind == m.SK_FN || kind == m.SK_CONST || kind == m.SK_TRAIT || kind == m.SK_MODULE
    if item && kind_at(s, at) == TK_IDENT {
        let key = (s.f.id as u64) * 4294967296 + (name_id as u64)
        if s.out.top.get(key).is_none() { s.out.top.insert(key, id) }
    }
    id
}

fn set_full_end(inout s: St, sym: u32, at: usize) {
    if sym == m.NONE { return }
    let t = tk(s, at)
    var x = s.out.symbols[sym as usize]
    x.full.end_line = t.line
    x.full.end_col = t.end_col
    s.out.symbols[sym as usize] = x
}

fn cur_fn(s: St) -> u32 {
    var k = s.ctx.len()
    while k > 0 {
        k -= 1
        let c = s.ctx[k]
        if c.kind == C_FN { return c.owner }
    }
    m.NONE
}

/// A parameter or local named by token `at`, visible until the innermost open brace closes.
fn add_local(inout s: St, at: usize, kind: u32, detail: List[u8], ty: List[u8], tn: u32) {
    let owner = cur_fn(s)
    let sp = tspan(s, at)
    let id = add_sym(inout s, kind, at, sp, owner, detail, ty, tn, m.NONE, false)
    let name_id = tk(s, at).sym
    let prev = match s.local_head.get(name_id) {
        Some(x) => x
        None => m.NONE
    }
    s.locals.push(Local(id, at as u32, OPEN, prev, (s.ctx.len() - 1) as u32))
    s.local_head.insert(name_id, (s.locals.len() - 1) as u32)
}

// ---- the declaration pass

/// Scan file `f` into `out`. `entry`: also record locals and references; `modules`: the
/// imported files already scanned (alias name id -> file id). Returns the file's imports.
pub fn scan(f: File, names: List[List[u8]], entry: bool, inout out: Out, modules: List[ModFile]) -> List[Import] uses ffi {
    var lh: Map[u32, u32] = Map.new()
    var dt: Map[u32, bool] = Map.new()
    var s = St(f, names, entry, 0, out, List.new(), List.new(), lh, dt, List.new(), List.new())
    s.ctx.push(Ctx(C_TOP, m.NONE, m.NONE, m.NONE))
    decls(inout s)
    fix_impls(inout s, modules)
    if entry { refs(inout s, modules) }
    out = s.out
    s.imports
}

fn decls(inout s: St) uses ffi {
    let n = s.f.toks.len()
    while s.i < n {
        let i = s.i
        let t = s.f.toks[i]
        if t.kind == TK_EOF { break }
        let top = s.ctx[s.ctx.len() - 1]
        if t.kind == TK_PUNCT && t.p == P_LBRACE {
            s.ctx.push(Ctx(C_BLOCK, top.owner, top.target, top.tname))
            s.i += 1
            continue
        }
        if t.kind == TK_PUNCT && t.p == P_RBRACE {
            close(inout s, i)
            s.i += 1
            continue
        }
        if top.kind == C_TOP || top.kind == C_IMPL || top.kind == C_TRAIT {
            item(inout s)
            continue
        }
        if !s.entry {
            s.i += 1
            continue
        }
        // inside a function body
        if t.kind == TK_IDENT && (t.sym == K_LET || t.sym == K_VAR) {
            let_decl(inout s, i)
            continue
        }
        if t.kind == TK_IDENT && t.sym == K_FOR && is_name(s, i + 1) && is_kw(s, i + 2, K_IN) {
            let d = text(s, i, i + 1)
            add_local(inout s, i + 1, m.SK_LOCAL, d, List.new(), m.NONE)
            s.i = i + 2
            continue
        }
        if t.kind == TK_PUNCT && t.p == P_FATARROW {
            arm_bindings(inout s, i)
            s.i += 1
            continue
        }
        if t.kind == TK_PUNCT && t.p == P_PIPE {
            closure_params(inout s, i)
            continue
        }
        s.i += 1
    }
    // braces still open end with the file
    while s.ctx.len() > 1 { close(inout s, n - 1) }
}

/// The brace at token `at` closes the innermost context: its locals end, a function's or
/// trait's full span ends.
fn close(inout s: St, at: usize) {
    if s.ctx.len() <= 1 { return }
    let c = s.ctx[s.ctx.len() - 1]
    let k = (s.ctx.len() - 1) as u32
    var j = s.locals.len()
    while j > 0 {
        j -= 1
        if s.locals[j].until != OPEN { continue }
        if s.locals[j].ctx < k { break }
        var l = s.locals[j]
        l.until = at as u32
        s.locals[j] = l
    }
    if c.kind == C_FN || c.kind == C_TRAIT { set_full_end(inout s, c.owner, at) }
    s.ctx.pop()
}

/// An item at the top level or in an `impl`/`trait` block.
fn item(inout s: St) uses ffi {
    let start = s.i
    var i = s.i
    var public = false
    while true {
        if is_kw(s, i, K_PUB) {
            public = true
            i += 1
        } else if is_kw(s, i, K_EXPORT) || is_kw(s, i, K_UNSAFE) || is_kw(s, i, K_COMPTIME) {
            i += 1
        } else if is_kw(s, i, K_EXTERN) {
            i += 1
            if kind_at(s, i) == TK_STR { i += 1 }
        } else {
            break
        }
    }
    let top = s.ctx[s.ctx.len() - 1]
    // methods are reachable wherever their type is
    if top.kind != C_TOP { public = true }
    if is_kw(s, i, K_FN) {
        fn_item(inout s, start, i, public)
    } else if is_kw(s, i, K_TYPE) {
        type_item(inout s, start, i, public)
    } else if is_kw(s, i, K_CONST) {
        const_item(inout s, start, i, public)
    } else if is_kw(s, i, K_TRAIT) {
        trait_item(inout s, start, i, public)
    } else if is_kw(s, i, K_IMPL) {
        impl_item(inout s, i)
    } else if is_kw(s, i, K_TEST) {
        test_item(inout s, i)
    } else if is_kw(s, i, K_IMPORT) {
        import_item(inout s, i)
    } else {
        s.i = i + 1
    }
}

/// `import "path" [as alias]`: a module symbol named by the alias (or the path's stem, whose
/// span is then the string).
fn import_item(inout s: St, i: usize) uses ffi {
    if kind_at(s, i + 1) != TK_STR {
        s.i = i + 1
        return
    }
    let path = name_of(s, i + 1)
    var at = i + 1
    if is_kw(s, i + 2, K_AS) && is_name(s, i + 3) { at = i + 3 }
    let full = range(s, i, at)
    let d = flat(s, i, at)
    let sym = add_sym(inout s, m.SK_MODULE, at, full, m.NONE, d, List.new(), m.NONE, m.NONE, false)
    if at == i + 1 {
        // named by the stem: fix the symbol's name (the token is the string)
        var x = s.out.symbols[sym as usize]
        x.name = stem(path)
        s.out.symbols[sym as usize] = x
    }
    let alias = if at == i + 1 { m.NONE } else { tk(s, at).sym }
    s.imports.push(Import(path, sym, alias))
    s.i = at + 1
}

/// The module name of an import path: the file stem with non-identifier bytes as `_`.
pub fn stem(path: List[u8]) -> List[u8] {
    let base = match bytes.rfind_byte(path, 47) {
        Some(k) => bytes.slice(path, k + 1, path.len())
        None => path
    }
    let st = match bytes.rfind_byte(base, 46) {
        Some(0) => base
        Some(k) => bytes.slice(base, 0, k)
        None => base
    }
    var out: List[u8] = List.new()
    for c in st {
        if bytes.is_ident(c) { out.push(c) } else { out.push(95) }
    }
    out
}

/// `fn name[G](params) -> T uses caps { body }` with `fn` at `kw`.
fn fn_item(inout s: St, start: usize, kw: usize, public: bool) uses ffi {
    if !is_name(s, kw + 1) {
        s.i = kw + 1
        return
    }
    let name_at = kw + 1
    let top = s.ctx[s.ctx.len() - 1]
    let kind = if top.kind == C_IMPL || top.kind == C_TRAIT { m.SK_METHOD } else { m.SK_FN }
    var j = name_at + 1
    if is_p(s, j, P_LBRACK) { j = closing(s, j) + 1 }
    var has_params = false
    let params_open = j
    var params_close = j
    var header_end = name_at
    if is_p(s, j, P_LPAREN) {
        has_params = true
        params_close = closing(s, j)
        header_end = params_close
        j = params_close + 1
    }
    // the return type and capabilities: up to the body or the end of the line
    while j < s.f.toks.len() {
        let t = s.f.toks[j]
        if t.kind == TK_EOF || t.kind == TK_NL { break }
        if t.kind == TK_PUNCT && (t.p == P_LBRACE || t.p == P_RBRACE) { break }
        header_end = j
        j += 1
    }
    var ret: List[u8] = List.new()
    var ret_tn = m.NONE
    if has_params && is_p(s, params_close + 1, P_ARROW) {
        let e = type_end(s, params_close + 2)
        ret = text(s, params_close + 2, e)
        ret_tn = head_of(s, params_close + 2, e)
    }
    let container = if top.kind == C_TRAIT { top.target } else { m.NONE }
    let own = if kind == m.SK_METHOD { top.tname } else { m.NONE }
    let full = range(s, start, header_end)
    let d = flat(s, start, header_end)
    let id = add_sym(inout s, kind, name_at, full, container, d, ret, ret_tn, own, public)
    if top.kind == C_IMPL && top.tname != m.NONE { s.pend.push((id as u64) * 4294967296 + (top.tname as u64)) }
    let b = skip_nl(s, j)
    let has_body = is_p(s, b, P_LBRACE)
    if !s.entry && !has_body {
        s.i = header_end + 1
        return
    }
    // the parameters' scope is the body (or just the signature when there is none)
    s.ctx.push(Ctx(C_FN, id, top.target, top.tname))
    if has_params && s.entry { params(inout s, params_open, params_close, top.tname) }
    if has_body {
        s.i = b + 1
        return
    }
    close(inout s, header_end)
    s.i = header_end + 1
}

/// Parameters between the parens at `a` and `b`: `[inout] name: T` or `self`.
fn params(inout s: St, a: usize, b: usize, tname: u32) uses ffi {
    var j = a + 1
    while j < b {
        j = skip_nl(s, j)
        if j >= b { break }
        var k = j
        if is_kw(s, k, K_INOUT) { k += 1 }
        if is_name(s, k) && is_p(s, k + 1, P_COLON) {
            let e = type_end(s, k + 2)
            let d = flat(s, j, e)
            let ty = text(s, k + 2, e)
            let tn = head_of(s, k + 2, e)
            add_local(inout s, k, m.SK_PARAM, d, ty, tn)
            j = e + 1
        } else if is_name(s, k) && tk(s, k).sym == S_SELF {
            var ty: List[u8] = List.new()
            if tname != m.NONE { ty = s.names[tname as usize] }
            let d = text(s, j, k)
            add_local(inout s, k, m.SK_PARAM, d, ty, tname)
            j = k + 1
        } else {
            j = k + 1
        }
        // on to the next comma at depth 0
        while j < b && !is_p(s, j, P_COMMA) {
            if is_p(s, j, P_LPAREN) || is_p(s, j, P_LBRACK) { j = closing(s, j) }
            j += 1
        }
        j += 1
    }
}

/// `type Name[G] = { fields }` or `= | V(fields) | ...`.
fn type_item(inout s: St, start: usize, kw: usize, public: bool) uses ffi {
    if !is_name(s, kw + 1) {
        s.i = kw + 1
        return
    }
    let name_at = kw + 1
    let tname = tk(s, name_at).sym
    var j = name_at + 1
    if is_p(s, j, P_LBRACK) { j = closing(s, j) + 1 }
    let full = range(s, start, name_at)
    let d = flat(s, start, line_end_tok(s, start))
    let id = add_sym(inout s, m.SK_TYPE, name_at, full, m.NONE, d, List.new(), m.NONE, m.NONE, public)
    if !is_p(s, j, P_EQ) {
        s.i = j
        return
    }
    j = skip_nl(s, j + 1)
    var last = j
    if is_p(s, j, P_LBRACE) {
        let e = closing(s, j)
        fields(inout s, j + 1, e, id, tname, public)
        last = e
    } else {
        // variants: `| Name` and an optional `(fields)`, possibly across lines
        while is_p(s, j, P_PIPE) {
            let v = j + 1
            if !is_name(s, v) { break }
            var vend = v
            var vd = s.names[tname as usize]
            vd.push(46)
            let vsp = tspan(s, v)
            let vid = add_sym(inout s, m.SK_VARIANT, v, vsp, id, List.new(), List.new(), m.NONE, m.NONE, public)
            if is_p(s, v + 1, P_LPAREN) {
                let e = closing(s, v + 1)
                fields(inout s, v + 2, e, vid, m.NONE, public)
                vend = e
            }
            bytes.append(inout vd, flat(s, v, vend))
            var x = s.out.symbols[vid as usize]
            x.full = range(s, v, vend)
            x.detail = vd
            s.out.symbols[vid as usize] = x
            last = vend
            j = skip_nl(s, vend + 1)
        }
    }
    set_full_end(inout s, id, last)
    // a record type's detail is all of it on one line when short
    if last > name_at {
        let whole = flat(s, start, last)
        if whole.len() <= 120 {
            var x = s.out.symbols[id as usize]
            x.detail = whole
            s.out.symbols[id as usize] = x
        }
    }
    s.i = last + 1
}

/// Fields `name: T` between tokens a and b (exclusive), separated by commas or newlines;
/// unnamed variant fields (`Circle(i32)`) are skipped. `own`: the record's type name id.
fn fields(inout s: St, a: usize, b: usize, owner: u32, own: u32, public: bool) uses ffi {
    var j = a
    while j < b {
        j = skip_nl(s, j)
        if j >= b { break }
        if is_name(s, j) && is_p(s, j + 1, P_COLON) {
            let e = type_end(s, j + 2)
            let full = range(s, j, e)
            let d = flat(s, j, e)
            let ty = text(s, j + 2, e)
            let tn = head_of(s, j + 2, e)
            add_sym(inout s, m.SK_FIELD, j, full, owner, d, ty, tn, own, public)
            j = e + 1
        } else {
            // skip an unnamed field's type
            while j < b && !is_p(s, j, P_COMMA) && kind_at(s, j) != TK_NL {
                if is_p(s, j, P_LPAREN) || is_p(s, j, P_LBRACK) { j = closing(s, j) }
                j += 1
            }
        }
        while j < b && (is_p(s, j, P_COMMA) || kind_at(s, j) == TK_NL) { j += 1 }
    }
}

fn const_item(inout s: St, start: usize, kw: usize, public: bool) uses ffi {
    if !is_name(s, kw + 1) {
        s.i = kw + 1
        return
    }
    var ty: List[u8] = List.new()
    var tn = m.NONE
    if is_p(s, kw + 2, P_COLON) {
        let e = type_end(s, kw + 3)
        ty = text(s, kw + 3, e)
        tn = head_of(s, kw + 3, e)
    }
    let e = line_end_tok(s, kw)
    let full = range(s, start, e)
    let d = flat(s, start, e)
    add_sym(inout s, m.SK_CONST, kw + 1, full, m.NONE, d, ty, tn, m.NONE, public)
    s.i = e + 1
}

fn trait_item(inout s: St, start: usize, kw: usize, public: bool) uses ffi {
    if !is_name(s, kw + 1) {
        s.i = kw + 1
        return
    }
    let full = range(s, start, kw + 1)
    let d = flat(s, start, kw + 1)
    let id = add_sym(inout s, m.SK_TRAIT, kw + 1, full, m.NONE, d, List.new(), m.NONE, m.NONE, public)
    let b = skip_nl(s, kw + 2)
    if is_p(s, b, P_LBRACE) {
        s.ctx.push(Ctx(C_TRAIT, id, id, S_SELF_TYPE))
        s.i = b + 1
    } else {
        s.i = kw + 2
    }
}

/// `impl[G] [Trait for] Target {`: its methods belong to the target type (resolved by name
/// once the file is scanned, `fix_impls`).
fn impl_item(inout s: St, kw: usize) uses ffi {
    var j = kw + 1
    if is_p(s, j, P_LBRACK) { j = closing(s, j) + 1 }
    var target_at = j
    var k = j
    while k < s.f.toks.len() && !is_p(s, k, P_LBRACE) && kind_at(s, k) != TK_EOF {
        if is_kw(s, k, K_FOR) { target_at = k + 1 }
        k += 1
    }
    let tname = if is_name(s, target_at) { tk(s, target_at).sym } else { m.NONE }
    s.ctx.push(Ctx(C_IMPL, m.NONE, m.NONE, tname))
    s.i = k + 1
}

fn test_item(inout s: St, kw: usize) uses ffi {
    if kind_at(s, kw + 1) != TK_STR {
        s.i = kw + 1
        return
    }
    let full = range(s, kw, kw + 1)
    let d = text(s, kw, kw + 1)
    let id = add_sym(inout s, m.SK_TEST, kw + 1, full, m.NONE, d, List.new(), m.NONE, m.NONE, false)
    let b = skip_nl(s, kw + 2)
    if is_p(s, b, P_LBRACE) {
        s.ctx.push(Ctx(C_FN, id, m.NONE, m.NONE))
        s.i = b + 1
    } else {
        s.i = kw + 2
    }
}

/// Builtin types and prelude variants that look like constructors.
fn is_variant_like(s: St, sym: u32) -> bool uses ffi {
    let n = s.names[sym as usize]
    bytes.eq(n, sys.lit("Some")) || bytes.eq(n, sys.lit("None")) || bytes.eq(n, sys.lit("Ok")) || bytes.eq(n, sys.lit("Err"))
}

/// `let`/`var` at `i`: a name with an optional annotation, or a pattern.
fn let_decl(inout s: St, i: usize) uses ffi {
    let j = i + 1
    if is_lower(s, j) && (is_p(s, j + 1, P_COLON) || is_p(s, j + 1, P_EQ)) {
        var ty: List[u8] = List.new()
        var tn = m.NONE
        var detail = text(s, i, j)
        if is_p(s, j + 1, P_COLON) {
            let e = type_end(s, j + 2)
            ty = text(s, j + 2, e)
            tn = head_of(s, j + 2, e)
            detail = flat(s, i, e)
        } else if is_upper(s, j + 2) && (is_p(s, j + 3, P_LPAREN) || is_p(s, j + 3, P_DOT)) && !is_variant_like(s, tk(s, j + 2).sym) {
            // `= Point(...)`, `= String.from(...)`: the type is the constructor's
            ty = name_of(s, j + 2)
            tn = tk(s, j + 2).sym
            detail.push(58)
            detail.push(32)
            bytes.append(inout detail, ty)
        }
        add_local(inout s, j, m.SK_LOCAL, detail, ty, tn)
        s.i = j + 1
        return
    }
    // a pattern up to `=` at depth 0 (or the end of the line)
    var k = j
    var depth: i32 = 0
    while k < s.f.toks.len() {
        let t = s.f.toks[k]
        if t.kind == TK_NL || t.kind == TK_EOF { break }
        if t.kind == TK_PUNCT {
            if t.p == P_LPAREN || t.p == P_LBRACK { depth += 1 }
            if t.p == P_RPAREN || t.p == P_RBRACK { depth -= 1 }
            if depth == 0 && (t.p == P_EQ || t.p == P_COLON || t.p == P_LBRACE) { break }
        }
        if binding_at(s, k) {
            let d = text(s, i, k)
            add_local(inout s, k, m.SK_LOCAL, d, List.new(), m.NONE)
        }
        k += 1
    }
    s.i = k
}

/// A name in a pattern that binds: lowercase, not `x.` / `.x` / `x(`.
fn binding_at(s: St, k: usize) -> bool {
    if !is_lower(s, k) { return false }
    if is_p(s, k + 1, P_LPAREN) || is_p(s, k + 1, P_DOT) { return false }
    if k > 0 && is_p(s, k - 1, P_DOT) { return false }
    true
}

/// The bindings of the arm whose `=>` is at `i`: names in its pattern, which starts after
/// the previous newline, `{` or `,`.
fn arm_bindings(inout s: St, i: usize) uses ffi {
    var a = i
    var depth: i32 = 0
    while a > 0 {
        let t = s.f.toks[a - 1]
        if t.kind == TK_NL { break }
        if t.kind == TK_PUNCT {
            if t.p == P_RPAREN || t.p == P_RBRACK { depth += 1 }
            if t.p == P_LPAREN || t.p == P_LBRACK { depth -= 1 }
            // a comma inside the pattern's parens doesn't end it
            if depth <= 0 && (t.p == P_LBRACE || t.p == P_COMMA) { break }
        }
        a -= 1
    }
    var k = a
    while k < i {
        if binding_at(s, k) && s.decl_tok.get(k as u32).is_none() {
            let d = name_of(s, k)
            add_local(inout s, k, m.SK_LOCAL, d, List.new(), m.NONE)
        }
        k += 1
    }
}

/// `|a, b: T|` at `i`: closure parameters (inside a function body `|` is nothing else).
fn closure_params(inout s: St, i: usize) uses ffi {
    var k = i + 1
    var close_at: usize = 0
    while k < s.f.toks.len() && k < i + 64 {
        let t = s.f.toks[k]
        if t.kind == TK_NL || t.kind == TK_EOF { break }
        if t.kind == TK_PUNCT && t.p == P_PIPE {
            close_at = k
            break
        }
        k += 1
    }
    if close_at == 0 {
        s.i = i + 1
        return
    }
    var j = i + 1
    while j < close_at {
        if is_lower(s, j) && (is_p(s, j + 1, P_COMMA) || is_p(s, j + 1, P_COLON) || j + 1 == close_at) && (j == i + 1 || is_p(s, j - 1, P_COMMA)) {
            var ty: List[u8] = List.new()
            var tn = m.NONE
            var e = j
            if is_p(s, j + 1, P_COLON) {
                e = type_end(s, j + 2)
                ty = text(s, j + 2, e)
                tn = head_of(s, j + 2, e)
            }
            let d = flat(s, j, e)
            add_local(inout s, j, m.SK_PARAM, d, ty, tn)
            j = e + 1
        } else {
            j += 1
        }
    }
    s.i = close_at + 1
}

/// Methods of `impl T` get T's symbol as their container: T declared in this file, else in
/// an imported one.
fn fix_impls(inout s: St, modules: List[ModFile]) {
    for p in s.pend {
        let meth = (p / 4294967296) as u32
        let tn = (p % 4294967296) as u32
        var t = lookup_top(s, s.f.id, tn)
        for mf in modules {
            if t == m.NONE { t = lookup_top(s, mf.file, tn) }
        }
        if t != m.NONE && s.out.symbols[t as usize].kind == m.SK_TYPE {
            var x = s.out.symbols[meth as usize]
            x.container = t
            s.out.symbols[meth as usize] = x
        }
    }
}

fn lookup_top(s: St, file: u32, name: u32) -> u32 {
    match s.out.top.get((file as u64) * 4294967296 + (name as u64)) {
        Some(x) => x
        None => m.NONE
    }
}

// ---- the reference pass (entry file only)

fn refs(inout s: St, modules: List[ModFile]) uses ffi {
    let n = s.f.toks.len()
    for i in 0..n {
        let t = s.f.toks[i]
        if t.kind != TK_IDENT || t.sym <= LAST_KEYWORD || t.sym == S_UNDERSCORE { continue }
        if s.decl_tok.get(i as u32).is_some() { continue }
        let target = resolve(s, i, modules)
        if target == m.NONE { continue }
        let sp = tspan(s, i)
        s.out.refs.push(m.Ref(sp, target))
        let k = s.out.symbols[target as usize].kind
        if k == m.SK_LOCAL || k == m.SK_PARAM || k == m.SK_FIELD || k == m.SK_CONST {
            let ty = s.out.sym_type[target as usize]
            if ty.len() > 0 { s.out.types.push(m.TypeAt(sp, ty)) }
        }
    }
}

/// What the name at token i refers to, or NONE.
fn resolve(s: St, i: usize, modules: List[ModFile]) -> u32 {
    if i > 0 && is_p(s, i - 1, P_DOT) { return member(s, i, modules) }
    let name = tk(s, i).sym
    // the newest local with this name that is open at i
    var l = match s.local_head.get(name) {
        Some(x) => x
        None => m.NONE
    }
    while l != m.NONE {
        let loc = s.locals[l as usize]
        if (loc.from as usize) < i && i <= (loc.until as usize) { return loc.sym }
        l = loc.prev
    }
    lookup_top(s, s.f.id, name)
}

/// `recv.name` at token i (the `.` at i - 1).
fn member(s: St, i: usize, modules: List[ModFile]) -> u32 {
    let name = tk(s, i).sym
    if i >= 2 && is_name(s, i - 2) {
        let recv = tk(s, i - 2).sym
        // `alias.Name`: an imported module's public item
        if i < 3 || !is_p(s, i - 3, P_DOT) {
            for mf in modules {
                if mf.alias == recv {
                    let t = lookup_top(s, mf.file, name)
                    if t != m.NONE && s.out.public[t as usize] { return t }
                    return m.NONE
                }
            }
        }
        // `Type.member` (an associated function) or `x.member` with x's type known
        var tn = m.NONE
        if is_upper(s, i - 2) && (i < 3 || !is_p(s, i - 3, P_DOT)) {
            tn = recv
        } else {
            let r = resolve(s, i - 2, modules)
            if r != m.NONE { tn = s.out.type_tn[r as usize] }
        }
        if tn != m.NONE {
            var c = head(s, name)
            while c != m.NONE {
                if s.out.owner_tn[c as usize] == tn { return c }
                c = s.out.next_member[c as usize]
            }
        }
    }
    // the only field or method with this name
    let c = head(s, name)
    if c != m.NONE && s.out.next_member[c as usize] == m.NONE { return c }
    m.NONE
}

fn head(s: St, name: u32) -> u32 {
    match s.out.members.get(name) {
        Some(x) => x
        None => m.NONE
    }
}
